// ASHEN CROWNS – Mission 1: „Die letzte Siedlung“ (Zeitalter I – The Last Settlement)
// Koordinaten in Kacheln. owner: 0 = Spieler (Glutkrone), 1 = Die Hohlen.
// voice: Event-ID aus assets/audio/manifest.ron (Sprachausgabe, optional).
(
    id: "m01_last_settlement",
    name: "Die letzte Siedlung",
    description: "Brennhollow, Aschmark, Jahr 897 n.F. Die Grenzsiedlung ist auf sich allein gestellt. Sichert Nahrung und Holz, bildet Soldaten aus, übersteht die Nächte – und findet die Quelle der Hohlen, bevor sie Brennhollow verschlingt.",
    map_seed: 897,
    start_resources: (gold: 300.0, wood: 200.0, stone: 100.0, food: 150.0),
    // Vorräte der Siedlung: Ausrüstung für die ersten Soldaten, etwas Baumaterial und Kleidung.
    start_goods: [("weapons", 10.0), ("armor", 4.0), ("tools", 4.0), ("planks", 20.0), ("clothing", 8.0), ("herbs", 6.0)],
    waves: (
        enabled: true,
        first_wave: 230.0,
        interval_day: 150.0,
        interval_night: 95.0,
        base_budget: 3.0,
        budget_per_wave: 1.7,
        night_mult: 1.5,
    ),
    defeat_tag: "player_keep",
    enemy_base_tag: "enemy_shrine",
    placements: [
        // Brennhollow
        (id: "keep", owner: 0, x: 12.0, y: 53.0, tag: Some("player_keep")),
        (id: "farmstead", owner: 0, x: 16.0, y: 57.0),
        (id: "hut", owner: 0, x: 9.0, y: 50.0),
        (id: "hut", owner: 0, x: 9.0, y: 58.0),
        (id: "woodcutter", owner: 0, x: 6.0, y: 55.0),
        (id: "worker", owner: 0, x: 16.5, y: 52.5, count: 5),
        (id: "swordsman", owner: 0, x: 18.5, y: 55.0, count: 3),
        (id: "hero_isolde", owner: 0, x: 17.5, y: 53.5, tag: Some("hero")),
        // Hohlschrein von Vael Dorn
        (id: "hollow_shrine", owner: 1, x: 60.0, y: 12.0, tag: Some("enemy_shrine")),
        (id: "bone_spire", owner: 1, x: 56.0, y: 13.0),
        (id: "bone_spire", owner: 1, x: 60.0, y: 17.0),
        (id: "boss_pale_reeve", owner: 1, x: 58.5, y: 16.0, tag: Some("boss"), guard: true),
        (id: "hollow_thrall", owner: 1, x: 56.5, y: 16.5, count: 4, guard: true),
        (id: "hollow_archer", owner: 1, x: 58.0, y: 11.0, count: 3, guard: true),
        (id: "grave_brute", owner: 1, x: 62.5, y: 16.5, guard: true),
        // Lager an der Ruinenmine in der Kartenmitte
        (id: "hollow_thrall", owner: 1, x: 52.5, y: 44.0, count: 3, guard: true),
        (id: "hollow_archer", owner: 1, x: 53.0, y: 46.5, count: 2, guard: true),
        // Vorposten an der nördlichen Furt
        (id: "hollow_thrall", owner: 1, x: 24.0, y: 9.5, count: 2, guard: true),
    ],
    objectives: [
        (id: "obj_farm", text: "Errichtet ein zweites Gehöft, um Nahrung und Wohnraum zu sichern."),
        (id: "obj_barracks", text: "Baut eine Kaserne."),
        (id: "obj_army", text: "Bildet eine Streitmacht von mindestens 8 Soldaten aus."),
        (id: "obj_survive", text: "Übersteht die erste Nacht."),
        (id: "obj_tower", text: "Errichtet einen Wachturm zum Schutz der Siedlung.", optional: true),
        (id: "obj_town", text: "Siedelt mehr Bürger an: Baut eine dritte Hütte. Bürger sind die Arbeitskräfte der Betriebe.", optional: true),
        (id: "obj_sawmill", text: "Errichtet ein Sägewerk, um aus Holz Bretter zu machen.", optional: true),
        (id: "obj_wall", text: "Zieht eine Mauer mit Tor, um die Siedlung zu schützen.", optional: true),
        (id: "obj_find_shrine", text: "Findet die Quelle der Hohlen jenseits des Flusses im Nordosten."),
        (id: "obj_reeve", text: "Vernichtet den Fahlen Vogt.", optional: true),
        (id: "obj_destroy_shrine", text: "Zerstört den Hohlschrein von Vael Dorn."),
        (id: "obj_skirmish", text: "Zerstört den Hohlschrein, bevor er Brennhollow verschlingt."),
        (id: "obj_survival", text: "Haltet Brennhollow so lange wie möglich gegen endlose Wellen."),
        (id: "obj_sandbox", text: "Freies Spiel: baut Brennhollow nach Belieben aus."),
    ],
    triggers: [
        // ------------------------------------------------------------ Kampagne
        (id: "intro", modes: [Campaign], condition: AtTime(1.0), actions: [
            Message(speaker: "Erzähler", text: "Jahr 897 nach dem Fall. Am Rand der Aschmark hält Brennhollow noch stand – dreißig Seelen, ein Bergfried, ein Feld. Und jede Nacht kommt der Nebel näher.", voice: Some("narrator.m01_opening")),
            Chronicle("Die Wächterin Isolde Raventhorn erreichte Brennhollow mit einer Handvoll Getreuer."),
        ]),
        (id: "intro_hal", modes: [Campaign], condition: AtTime(9.0), actions: [
            Message(speaker: "Bruder Hal Venn", text: "Wächterin, die Speicher reichen nicht über den Winter. Wir brauchen ein zweites Gehöft und Holz aus dem Westwald – bevor es dunkel wird.", voice: Some("char_hal_venn.m01_intro")),
            AddObjective("obj_farm"),
        ]),
        (id: "farm_done", modes: [Campaign], condition: BuildingCount(building: "farmstead", count: 2), actions: [
            CompleteObjective("obj_farm"),
            Message(speaker: "Bruder Hal Venn", text: "Die Felder werden uns ernähren. Doch Brot allein hält die Toten nicht auf. Errichtet eine Kaserne.", voice: Some("char_hal_venn.m01_first_farm")),
            AddObjective("obj_barracks"),
            AddObjective("obj_tower"),
        ]),
        (id: "town_hint", modes: [Campaign], condition: AtTime(40.0), actions: [
            Message(speaker: "Bruder Hal Venn", text: "Die Hütten füllen sich mit Bürgern, Wächterin. Sie schlagen Holz und arbeiten in den Betrieben – wenn Ihr sie ernährt und mäßig besteuert. Öffnet das Lager mit L und die Stadtübersicht mit C.", voice: None),
            AddObjective("obj_town"),
        ]),
        (id: "town_done", modes: [Campaign], condition: BuildingCount(building: "hut", count: 3), actions: [
            CompleteObjective("obj_town"),
            AddObjective("obj_sawmill"),
        ]),
        (id: "sawmill_done", modes: [Campaign], condition: BuildingCompleted("sawmill"), actions: [
            CompleteObjective("obj_sawmill"),
            Message(speaker: "Bruder Hal Venn", text: "Bretter! Mit ihnen bauen wir besser – und die Schmiede werden Eisen verlangen, sobald Brennhollow zur Burg gewachsen ist.", voice: None),
            AddObjective("obj_wall"),
        ]),
        (id: "wall_done", modes: [Campaign], condition: BuildingCompleted("gate"), actions: [
            CompleteObjective("obj_wall"),
        ]),
        (id: "barracks_hint", modes: [Campaign], condition: All([AtTime(150.0), Any([NightStarted(1), AtTime(170.0)])]), actions: [
            AddObjective("obj_barracks"),
        ]),
        (id: "barracks_done", modes: [Campaign], condition: BuildingCompleted("barracks"), actions: [
            CompleteObjective("obj_barracks"),
            Message(speaker: "Bruder Hal Venn", text: "Die Kaserne steht. Bildet Speerträger und Bogenschützen aus – die Hohlen kennen keine Furcht, aber sie kennen Stahl.", voice: Some("char_hal_venn.m01_barracks")),
            AddObjective("obj_army"),
        ]),
        (id: "army_done", modes: [Campaign], condition: All([ObjectiveCompleted("obj_barracks"), MilitaryCount(8)]), actions: [
            CompleteObjective("obj_army"),
        ]),
        (id: "tower_done", modes: [Campaign], condition: BuildingCompleted("watchtower"), actions: [
            CompleteObjective("obj_tower"),
        ]),
        (id: "first_night", modes: [Campaign], condition: NightStarted(1), actions: [
            Message(speaker: "Erzähler", text: "Die Sonne sank hinter die Aschhügel. Aus dem Nordosten wehte ein Geruch nach kaltem Stein und alten Gräbern.", voice: Some("narrator.m01_night_falls")),
            AddObjective("obj_survive"),
        ]),
        (id: "wave_warning", modes: [Campaign], condition: AtTime(215.0), actions: [
            Message(speaker: "Bruder Hal Venn", text: "Hört Ihr das Horn? Sie kommen über die Brücke! Alle Mann an den Bergfried!", voice: Some("char_hal_venn.m01_wave_warning")),
        ]),
        (id: "survived", modes: [Campaign], condition: DayStarted(2), actions: [
            CompleteObjective("obj_survive"),
            AddObjective("obj_find_shrine"),
            Message(speaker: "Bruder Hal Venn", text: "Wir leben. Doch solange ihre Quelle brennt, kehren sie jede Nacht zurück. Folgt der alten Straße nach Nordosten, über den Fluss.", voice: None),
        ]),
        (id: "shrine_found", modes: [Campaign], condition: TagDiscovered("enemy_shrine"), actions: [
            CompleteObjective("obj_find_shrine"),
            AddObjective("obj_reeve"),
            AddObjective("obj_destroy_shrine"),
            Message(speaker: "Bruder Hal Venn", text: "Bei der Flamme … eine Aureth-Kapelle, und der Schleier darin ist offen. Zerstört den Schrein, Wächterin. Und hütet Euch vor dem, der ihn bewacht.", voice: Some("char_hal_venn.m01_shrine_found")),
            Chronicle("Die Späher Brennhollows fanden den Hohlschrein in den Ruinen von Vael Dorn."),
        ]),
        (id: "reeve_dead", modes: [Campaign, Skirmish], condition: TagDead("boss"), actions: [
            CompleteObjective("obj_reeve"),
            Message(speaker: "Isolde Raventhorn", text: "Der Vogt ist gefallen. Jetzt der Schrein.", voice: None),
        ]),
        (id: "victory", modes: [Campaign], condition: TagDead("enemy_shrine"), actions: [
            CompleteObjective("obj_destroy_shrine"),
            Message(speaker: "Bruder Hal Venn", text: "Der Riss ist verschlossen. Brennhollow wird diesen Winter überstehen – dank Euch, Wächterin.", voice: Some("char_hal_venn.m01_victory")),
            Message(speaker: "Erzähler", text: "So begann es: nicht mit einer Krone, sondern mit einem Dorf, das sich weigerte zu sterben.", voice: Some("narrator.m01_victory")),
            Victory,
        ]),
        // ------------------------------------------------------------ Gefecht
        (id: "skirmish_intro", modes: [Skirmish], condition: AtTime(1.0), actions: [
            AddObjective("obj_skirmish"),
            Message(speaker: "", text: "Gefecht: Zerstört den Hohlschrein im Nordosten. Die Wellen kommen schneller.", voice: None),
        ]),
        (id: "skirmish_win", modes: [Skirmish], condition: TagDead("enemy_shrine"), actions: [
            CompleteObjective("obj_skirmish"),
        ]),
        // ------------------------------------------------------------ Überleben
        (id: "survival_intro", modes: [Survival], condition: AtTime(1.0), actions: [
            AddObjective("obj_survival"),
            Message(speaker: "", text: "Überleben: Der Schrein ist unzerstörbar. Wie viele Wellen hält Brennhollow?", voice: None),
        ]),
        (id: "survival_10", modes: [Survival], condition: WavesSurvived(10), actions: [
            Chronicle("Zehn Wellen brachen an den Palisaden von Brennhollow."),
            Grant((gold: 500.0, wood: 300.0)),
        ]),
        // ------------------------------------------------------------ Sandbox
        (id: "sandbox_intro", modes: [Sandbox], condition: AtTime(1.0), actions: [
            AddObjective("obj_sandbox"),
        ]),
    ],
)
