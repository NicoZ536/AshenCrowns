// ASHEN CROWNS – Gegenstände der Helden (Waffe, Rüstung, Amulett, Ringe, Tränke).
// slot: Weapon | Armor | Amulet | Ring | Potion        rarity: Common | Uncommon | Rare | Epic | Unique
// mods: Wertänderungen (hp, mana, damage = fester Zusatzschaden, damage_pct, armor, speed_pct, hp_regen,
//       mana_regen, xp_pct, cooldown_pct); use_effect: nur Tränke (Sofortwirkung, optional zeitlicher Bonus).
// Beute: Einheiten (units.ron → loot), Lager (rules.ron → camp_loot) und Bosse. Mods können Einträge ersetzen.
(
    items: [
        // ---------------------------------------------------------------- Waffen
        (id: "rusty_sword", name: "Rostiges Schwert", slot: Weapon, rarity: Common, value: 12.0,
         description: "Ein altes Grenzschwert. Es hat schon bessere Tage gesehen.", mods: (damage: 3.0)),
        (id: "steel_sword", name: "Stahlschwert", slot: Weapon, rarity: Uncommon, value: 45.0,
         description: "Gut geschmiedeter Stahl aus den Werkstätten Valemarks.", mods: (damage: 6.0, damage_pct: 0.03)),
        (id: "pilgrim_staff", name: "Pilgerstab", slot: Weapon, rarity: Uncommon, value: 50.0,
         description: "Ein Stab aus Eschenholz, geweiht an den Schreinen der Ewigen Flamme.", mods: (damage: 3.0, mana: 30.0, mana_regen: 0.4)),
        (id: "embersteel_blade", name: "Glutstahlklinge", slot: Weapon, rarity: Rare, value: 140.0,
         description: "Im Aschenfeuer gehärtet; die Schneide glimmt schwach.", mods: (damage: 10.0, damage_pct: 0.06)),
        (id: "skarn_greataxe", name: "Skarn-Streitaxt", slot: Weapon, rarity: Rare, value: 150.0,
         description: "Schwere Doppelaxt der Nordclans. Wer sie schwingt, fürchtet den Tod nicht.", mods: (damage: 14.0, hp: 30.0)),
        (id: "edran_blade", name: "Edrans Grenzklinge", slot: Weapon, rarity: Unique, value: 600.0,
         description: "Die Klinge von Markgraf Edran Raventhorn, gefallen beim Fall von Grauwall. Sie erinnert sich an jede Wacht.",
         mods: (damage: 16.0, damage_pct: 0.10, hp: 60.0, cooldown_pct: 0.10)),

        // ---------------------------------------------------------------- Rüstungen
        (id: "padded_jerkin", name: "Wattierter Wams", slot: Armor, rarity: Common, value: 14.0,
         description: "Gepolsterte Leinenlagen gegen Hiebe und Kälte.", mods: (armor: 1.0, hp: 20.0)),
        (id: "chain_hauberk", name: "Kettenhemd", slot: Armor, rarity: Uncommon, value: 55.0,
         description: "Tausend Ringe, jeder von Hand geschlossen.", mods: (armor: 2.0, hp: 50.0)),
        (id: "ember_plate", name: "Glutkronen-Plattenpanzer", slot: Armor, rarity: Rare, value: 170.0,
         description: "Brünierte Platten mit dem Wappen der Glutkrone. Warm, selbst im Winter.", mods: (armor: 4.0, hp: 90.0)),
        (id: "grauwall_aegis", name: "Aegis von Grauwall", slot: Armor, rarity: Unique, value: 650.0,
         description: "Der Harnisch der Stammfeste Grauwall. Die Wunden der Träger schließen sich schneller, als sie sollten.",
         mods: (armor: 5.0, hp: 140.0, hp_regen: 1.5)),

        // ---------------------------------------------------------------- Amulette
        (id: "bone_charm", name: "Knochenamulett", slot: Amulet, rarity: Common, value: 15.0,
         description: "Ein Talisman aus Hohlknochen. Er riecht nach Asche, schützt aber.", mods: (hp_regen: 0.5)),
        (id: "flamekeeper_pendant", name: "Flammenwahrer-Anhänger", slot: Amulet, rarity: Uncommon, value: 60.0,
