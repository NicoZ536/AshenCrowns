        (id: "ashglass_heart", name: "Aschglas-Herz", slot: Amulet, rarity: Unique, value: 700.0,
         description: "Ein Kristall aus reinem Aschglas, der im Takt eines fremden Herzens pulsiert.",
         mods: (mana: 80.0, mana_regen: 1.2, cooldown_pct: 0.12, damage_pct: 0.08)),

        // ---------------------------------------------------------------- Ringe
        (id: "copper_ring", name: "Kupferring", slot: Ring, rarity: Common, value: 10.0,
