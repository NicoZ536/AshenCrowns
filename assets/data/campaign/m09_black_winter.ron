  objectives: [
    (id: "obj_oath", text: "Leistet den Schwur an Torvald Eisenhand.", optional: false),
    (id: "obj_hold", text: "Haltet Hrimgard bis zum Morgen.", optional: false),
    (id: "obj_keep", text: "Der Bergfried darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "schwur", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Torvald Eisenhand", text: "Die Wächterin des Südens erklimmt also meinen Berg. Du bist kleiner, als die Lieder sagen.", voice: Some("char_torvald.m09_schwur_a")), (speaker: "Isolde Raventhorn", text: "Lieder übertreiben. Eure machen Euch angeblich größer und weiser.", voice: Some("hero_isolde.m09_schwur_b")), (speaker: "Torvald Eisenhand", text: "Ha! Sie beißt! Gut. Die Toten kamen vor drei Nächten über den hohen Pass. Wir haben vierzig der Unseren begraben. Vierzig.", voice: Some("char_torvald.m09_schwur_c")), (speaker: "Isolde Raventhorn", text: "Dann wollen wir dasselbe. Die Hohlen fort und unsere Toten in Frieden.", voice: Some("hero_isolde.m09_schwur_d")), (speaker: "Torvald Eisenhand", text: "Wollen ist billig. Der Ahnenpfad verlangt mehr. Südländer zahlen in Gold, Sippe zahlt in Blut. Was bist du?", voice: Some("char_torvald.m09_schwur_e"))]), Decision((id: "torvald_oath", speaker: "Torvald Eisenhand", title: "Der Schwur der Ahnen", text: "Wähle, bevor der Schnee die Gräber bedeckt, Wächterin. Meine Ahnen sind ungeduldig.", voice: Some("char_torvald.m09_schwur_f"), options: [(flag: "torvald_blood", label: "Den Blutschwur leisten", detail: "Torvald und seine Clankrieger kämpfen an Eurer Seite – auch in späteren Schlachten.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Gib mir das Messer. Mein Blut auf euren Steinen und mein Schwert an der Seite deines Clans.", voice: Some("hero_isolde.m09_schwur_a_a")), (speaker: "Torvald Eisenhand", text: "Hört ihr das, Väter? Skarnheim hat eine neue Schwester! Bringt den Met – und die Äxte!", voice: Some("char_torvald.m09_schwur_a_b"))]), SpawnUnits(unit: "hero_torvald", owner: 0, area: "hof", count: 1, attack: false, tag: Some("torvald")), SpawnUnits(unit: "shieldbearer", owner: 0, area: "hof", count: 6, attack: false, tag: None), SpawnUnits(unit: "halberdier", owner: 0, area: "hof", count: 4, attack: false, tag: None)]), (flag: "torvald_gold", label: "Mit Gold bezahlen", detail: "Söldner verstärken Euch jetzt; Torvald bleibt kühl.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Ich bin keine Sippe, Torvald. Aber mein Gold ist gut und mein Wort ist besser. Nenne deinen Preis.", voice: Some("hero_isolde.m09_schwur_b_a")), (speaker: "Torvald Eisenhand", text: "Gold also. Eisen bekommst du, und Krieger gegen Lohn. Aber erwarte nicht, dass sie für dich sterben.", voice: Some("char_torvald.m09_schwur_b_b"))]), SpawnUnits(unit: "halberdier", owner: 0, area: "hof", count: 5, attack: false, tag: None), SpawnUnits(unit: "crossbowman", owner: 0, area: "hof", count: 7, attack: false, tag: None)])])), AddObjective("obj_oath")], modes: []),
    (id: "start", condition: Any([Flag("torvald_blood"), Flag("torvald_gold")]), actions: [CompleteObjective("obj_oath"), AddObjective("obj_hold"), AddObjective("obj_keep"), SetWeather(Fog), Dialogue([(speaker: "Erzähler", text: "Der Schnee fiel schwarz, wo die Asche ihn berührte. Auf den Zinnen von Hrimgard sangen die Skaldinnen ihre Ahnenlieder gegen den Wind, und der Wind sang zurück – mit hohlen Stimmen.", voice: Some("narrator.m09_sturm_a"))])], modes: []),
    (id: "w1", condition: AtTime(75.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 10, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 3, attack: true, tag: None)], modes: []),
    (id: "w2", condition: AtTime(135.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "nord", count: 12, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "nord", count: 4, attack: true, tag: None)], modes: []),
    (id: "w3", condition: AtTime(200.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "ost", count: 10, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "ost", count: 2, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "ost", count: 4, attack: true, tag: None)], modes: []),
    (id: "w4", condition: AtTime(265.0), actions: [Dialogue([(speaker: "Torvald Eisenhand", text: "Kolosse! Die Äxte an die Mauer, ihr Brüder – bricht der Koloss die Mauer, brechen wir den Koloss!", voice: Some("char_torvald.m09_kolosse_a"))]), SpawnUnits(unit: "grave_brute", owner: 1, area: "sued", count: 2, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "sued", count: 10, attack: true, tag: None), SpawnUnits(unit: "bat_swarm", owner: 1, area: "sued", count: 3, attack: true, tag: None)], modes: []),
    (id: "w5", condition: AtTime(335.0), actions: [SpawnUnits(unit: "ghoul", owner: 1, area: "nord", count: 6, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "nord", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "nord", count: 12, attack: true, tag: None)], modes: []),
    (id: "w6", condition: AtTime(405.0), actions: [SpawnUnits(unit: "grave_brute", owner: 1, area: "west", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 14, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 6, attack: true, tag: None)], modes: []),
    (id: "morgen", condition: AtTime(500.0), actions: [CompleteObjective("obj_hold"), CompleteObjective("obj_keep"), Dialogue([(speaker: "Erzähler", text: "Als der Morgen kam, lagen die Hohlen wie umgekippte Statuen im Schnee. Auf der Mauer standen die Überlebenden und sahen nicht hinunter – sie sahen nach Osten, wo es hell wurde.", voice: Some("narrator.m09_morgen_a"))]), Chronicle("Hrimgard hielt im Schwarzen Winter."), Victory], modes: []),
