  starts: [
    (owner: 0, x: 40.0, y: 40.0),
    (owner: 1, x: 40.0, y: 4.0),
  ],
  briefing: "Hrimgard, Skarnheim, Jahr 905 n.F. Die Hohlen sind über die Pässe gekommen, die Skarnheim seit tausend Jahren mit Schnee und Schwüren verschließt. Torvald Eisenhand hält Hrimgard mit der Hälfte seines Clans; die andere Hälfte liegt in den Gräbern. Er verlangt einen Preis für seinen Schild: Blut oder Gold. Entscheidet beim Torwächter, wie Ihr den Schwur leistet, und haltet dann die Bergfeste bis zum Morgen der dritten Stunde. Der Winter frisst alles Leben, aber nicht den Willen der Ahnen. Die Hohlen kommen aus drei Richtungen, und mit ihnen Hexen und Kolosse.",
  author: "Ashen Crowns",
  year: Some(905),
  unit_cap: None,
  start_time: Some(0.8),
  kind: "Verteidigung mit Verbündeten",
  victory_text: "Als der Morgen über Hrimgard anbrach, lagen die Hohlen in Reihen vor den Mauern – und die Ahnen sangen, so sagte man, bis ins Tal.",
  defeat_text: "Hrimgard fiel in einer Nacht aus Schnee und Asche. Die Pässe Skarnheims standen offen.",
  intro_chronicle: "",
  chronicle_title: "Der Schwarze Winter",
