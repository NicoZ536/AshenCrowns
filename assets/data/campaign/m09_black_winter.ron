    (requires: ["core_kept"], forbids: [], note: "Zwei Kampfmagier aus Brennhollow haben den Aschglas-Kern studiert und stehen auf den Zinnen.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "battle_mage", owner: 0, x: 40.0, y: 29.0, count: 2, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
    (requires: ["oath_crown"], forbids: [], note: "Königliche Armbrustschützen haben Hrimgard erreicht.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "crossbowman", owner: 0, x: 36.0, y: 36.0, count: 4, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
