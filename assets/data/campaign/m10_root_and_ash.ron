(
  id: "m10_root_and_ash",
  name: "Wurzel und Asche",
  description: "Im Dornwald welken die Bäume von innen. Sylaen der Veyl führt Isolde zur Wurzelmutter, deren Wurzeln grau geworden sind – und die Wahl, was mit ihr geschehen soll, liegt bei Euch.",
  map_seed: 90610,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 0.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
    interval_day: 150.0,
    interval_night: 95.0,
    base_budget: 3.0,
    budget_per_wave: 1.7,
    night_mult: 1.5,
  ),
  placements: [
    (id: "hero_isolde", owner: 0, x: 10.0, y: 78.5, count: 0, tag: Some("hero"), guard: false, camp: None),
    (id: "hero_hal_venn", owner: 0, x: 12.0, y: 77.0, count: 0, tag: Some("hero_hal"), guard: false, camp: None),
    (id: "swordsman", owner: 0, x: 8.0, y: 76.5, count: 5, tag: None, guard: false, camp: None),
    (id: "halberdier", owner: 0, x: 12.5, y: 80.5, count: 2, tag: None, guard: false, camp: None),
    (id: "archer", owner: 0, x: 9.0, y: 81.0, count: 5, tag: None, guard: false, camp: None),
    (id: "priest", owner: 0, x: 13.5, y: 78.5, count: 2, tag: None, guard: false, camp: None),
    (id: "knight", owner: 0, x: 6.5, y: 80.0, count: 2, tag: None, guard: false, camp: None),
    (id: "hollow_thrall", owner: 1, x: 30.0, y: 66.0, count: 1, tag: Some("wk1"), guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 28.5, y: 64.5, count: 3, tag: None, guard: true, camp: None),
    (id: "hollow_archer", owner: 1, x: 32.5, y: 68.0, count: 2, tag: None, guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 44.0, y: 42.0, count: 1, tag: Some("wk2"), guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 42.0, y: 44.0, count: 2, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 46.5, y: 40.5, count: 3, tag: None, guard: true, camp: None),
    (id: "grave_brute", owner: 1, x: 60.0, y: 26.0, count: 1, tag: Some("wk3"), guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 58.0, y: 28.0, count: 3, tag: None, guard: true, camp: None),
    (id: "hollow_archer", owner: 1, x: 62.5, y: 24.0, count: 2, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 36.0, y: 56.0, count: 2, tag: Some("ambush"), guard: true, camp: None),
  ],
  objectives: [
    (id: "obj_camps", text: "Räumt die drei Lager der Welkenden.", optional: false),
    (id: "obj_grove", text: "Erreicht den Herzhain und stellt Euch der Wurzelmutter.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "wald", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Der Dornwald war älter als die Götter, und er hatte es nie vergessen. Wer ihn betrat, tat es auf Zehenspitzen – und wer ihn verließ, nahm ein wenig Rinde in den Knochen mit.", voice: Some("narrator.m10_wald_a")), (speaker: "Sylaen der Veyl", text: "Geh leise, Wächterin. Hier sprach Calyx zuletzt zu uns, bevor die Götter verstummten. Was welkt, welkt von innen – nicht durch Feuer, sondern durch einen Traum.", voice: Some("char_sylaen.m10_wald_b"))]), AddObjective("obj_camps"), AddObjective("obj_grove"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn folgte Sylaen in den Dornwald.")], modes: []),
    (id: "lager1", condition: TagDead("wk1"), actions: [Dialogue([(speaker: "Sylaen der Veyl", text: "Sie sind nicht böse. Sie sind leer. Der Wald hat ihre Namen vergessen, und sie suchen sie in unseren Stimmen.", voice: Some("char_sylaen.m10_lager1_a"))])], modes: []),
    (id: "lager3", condition: TagDead("wk3"), actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Die Wurzeln sind grau. Wie das Aschglas bei Vael Dorn. Sylaen, was immer da im Hain wartet, es ist dasselbe Grau.", voice: Some("hero_isolde.m10_lager3_a"))])], modes: []),
    (id: "lager_alle", condition: All([TagDead("wk1"), TagDead("wk2"), TagDead("wk3")]), actions: [CompleteObjective("obj_camps")], modes: []),
    (id: "hain", condition: All([UnitsInArea(area: "hain", count: 2), TagDead("wk3")]), actions: [Dialogue([(speaker: "Die Wurzelmutter", text: "Kinder … so viele Kinder mit Feuer in den Händen … seid ihr gekommen, um mich zu halten oder um mich zu verbrennen?", voice: Some("boss_root_mother.m10_hain_a")), (speaker: "Sylaen der Veyl", text: "Sie träumt den Traum des Tiefs. Erwacht sie so, wird der Dornwald zu einer zweiten Schleiernarbe.", voice: Some("char_sylaen.m10_hain_b")), (speaker: "Die Stimme aus dem Tief", text: "Eure Götter wurden nicht getötet, kleine Flamme. Sie wurden … verdaut. Calyx schmeckte nach Frühling.", voice: Some("char_deep_voice.m10_hain_c")), (speaker: "Sylaen der Veyl", text: "Es gibt zwei Wege, und ich hasse beide. Verbrenne die grauen Wurzeln, und sie stirbt. Oder tritt in ihren Traum und versuche, sie selbst zu wecken.", voice: Some("char_sylaen.m10_hain_d"))]), Decision((id: "rootmother", speaker: "Sylaen der Veyl", title: "Die Wurzelmutter", text: "Entscheide, Wächterin. Der Wald wartet nicht – und sie auch nicht.", voice: Some("char_sylaen.m10_hain_e"), options: [(flag: "rootmother_burned", label: "Die grauen Wurzeln verbrennen", detail: "Die Wurzelmutter stirbt; der Wald überlebt verwundet. Der Dornenbund wird Euch das nicht vergessen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Es tut mir leid, Sylaen. Ich kann nicht einen ganzen Wald auf einen Traum setzen. Bringt die Fackeln.", voice: Some("hero_isolde.m10_hain_a_a")), (speaker: "Die Wurzelmutter", text: "Warm … so warm … schlaft gut, Kinder …", voice: Some("boss_root_mother.m10_hain_a_b")), (speaker: "Sylaen der Veyl", text: "Der Dornwald wird sich an dieses Feuer erinnern, Wächterin. Und ich auch.", voice: Some("char_sylaen.m10_hain_a_c"))]), SpawnUnits(unit: "boss_root_mother", owner: 1, area: "hain_mitte", count: 1, attack: true, tag: Some("boss")), SetFlag("rootmother_burn")]), (flag: "rootmother_pact", label: "In ihren Traum eintreten", detail: "Sie erwacht – vielleicht. Der Dornenbund steht dann an Eurer Seite.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Keine Feuer mehr. Zeig mir den Weg hinein.", voice: Some("hero_isolde.m10_hain_b_a")), (speaker: "Die Stimme aus dem Tief", text: "Ja … komm herein. Ich habe so lange gewartet, dich richtig kennenzulernen.", voice: Some("char_deep_voice.m10_hain_b_b")), (speaker: "Sylaen der Veyl", text: "Halt meine Hand und lass nicht los. Was immer du dort drin hörst … es ist nicht dein Freund.", voice: Some("char_sylaen.m10_hain_b_c"))]), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "hain", count: 8, attack: true, tag: Some("traum")), SpawnUnits(unit: "ghoul", owner: 1, area: "hain", count: 3, attack: true, tag: Some("traum")), SetFlag("rootmother_dream")])]))], modes: []),
    (id: "sieg_burn", condition: All([Flag("rootmother_burn"), TagDead("boss")]), actions: [CompleteObjective("obj_grove"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Der Hain brannte drei Tage lang. Als die Asche kalt war, wuchs zwischen den Wurzeln ein einzelner heller Trieb – und niemand wagte es, ihn zu fällen.", voice: Some("narrator.m10_sieg_a_a"))]), Chronicle("Die Wurzelmutter starb im Feuer."), Victory], modes: []),
    (id: "sieg_dream", condition: All([Flag("rootmother_dream"), EnemyUnitsAtMost(0)]), actions: [CompleteObjective("obj_grove"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Isolde Raventhorn kehrte nach drei Atemzügen aus dem Traum zurück – und sprach in den folgenden Wochen nicht mehr als nötig. Die Wurzelmutter aber erwachte, und der Dornwald antwortete mit Blüten.", voice: Some("narrator.m10_sieg_b_a"))]), Chronicle("Isolde Raventhorn trat in den Traum der Wurzelmutter."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel im Dornwald.", voice: None), Defeat], modes: []),
  ],
  defeat_tag: "",
  enemy_base_tag: "",
