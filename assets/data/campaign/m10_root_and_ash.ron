    (owner: 1, x: 60.0, y: 26.0),
  ],
  briefing: "Dornwald, Jahr 906 n.F. Am Waldrand sterben die Bäume von innen: Das Laub bleibt grün, die Rinde wird grau, und nachts hört man den Wald atmen. Sylaen der Veyl, Druidin des Dornenbundes, hat Isolde Raventhorn um Hilfe gebeten – mit der Warnung, dass sie nicht verspricht, was sie nicht halten kann. Ihr führt einen kleinen Spähtrupp, kein Heer, durch drei Lager der Welkenden bis zum Herzhain, wo die Wurzelmutter träumt. Dort entscheidet sich, ob Isolde sie verbrennt oder in den Traum tritt und versucht, sie zu wecken.",
  author: "Ashen Crowns",
  year: Some(906),
  unit_cap: None,
  start_time: Some(0.34),
  free_economy: true,
  kind: "Heldenmission ohne Basis",
  victory_text: "Der Hain war still, und aus den grauen Wurzeln stieg ein Hauch, der nach Frühling roch. Wie teuer er bezahlt war, wusste nur, wer dabei gewesen war.",
  defeat_text: "Der Dornwald behielt seine Wanderer – und die Wurzelmutter ihren grauen Traum.",
  intro_chronicle: "",
  chronicle_title: "Wurzel und Asche",
  variants: [
    (requires: ["wendel_recruited"], forbids: [], note: "Zwei Späher der Grauen Kompanie begleiten den Trupp als Fährtensucher.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "archer", owner: 0, x: 7.5, y: 79.5, count: 3, tag: None, guard: false, camp: None), (id: "scout_rider", owner: 0, x: 6.0, y: 77.0, count: 2, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
    (requires: ["core_kept"], forbids: [], note: "Das Tiefe wittert die Scherbe des Aschglases: Ein zusätzlicher Hinterhalt wartet vor dem zweiten Lager.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "hollow_thrall", owner: 1, x: 36.0, y: 50.0, count: 4, tag: None, guard: true, camp: None), (id: "hollow_archer", owner: 1, x: 38.5, y: 52.0, count: 3, tag: None, guard: true, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
    (requires: ["nel_sheltered"], forbids: [], note: "Nel hat einen Weg durch den Wald geträumt; der Hinterhalt vor dem zweiten Lager entfällt.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: ["ambush"], placements: [], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
