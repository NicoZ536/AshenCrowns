// ASHEN CROWNS – Kampagnenplan „Das Zeitalter der Gefallenen“ (erzeugt von `ashen_tools forge-campaign`).
(
  id: "age_of_the_fallen",
  name: "Das Zeitalter der Gefallenen",
  intro: "Eldraeth, Jahr 897 nach dem Fall. Eine Wächterin, ein sterbendes Grenzland und eine Welt, die vergessen hat, wie es ist, ohne Furcht zu schlafen.",
  chapters: [
    (
      id: "age1",
      numeral: "I",
      title: "Die letzte Siedlung",
      subtitle: "The Last Settlement",
      years: "897–899 n.F.",
      blurb: "Jahr 897 nach dem Fall. Am Rand der Aschmark hält Brennhollow noch stand – dreißig Seelen, ein Bergfried, ein Feld. Und jede Nacht kommt der Nebel näher.",
      voice: Some("narrator.age_age1_a"),
      missions: [
        (id: "m01_last_settlement", needs: [], if_flags: [], unless_flags: [], finale: false, pos: (0.34, 0.72)),
        (id: "m02_harrowmere", needs: ["m01_last_settlement"], if_flags: [], unless_flags: [], finale: false, pos: (0.24, 0.66)),
        (id: "m03_grey_road", needs: ["m02_harrowmere"], if_flags: [], unless_flags: [], finale: false, pos: (0.38, 0.6)),
      ],
    ),
    (
      id: "age2",
      numeral: "II",
      title: "Die aufsteigende Krone",
      subtitle: "The Rising Crown",
      years: "899–902 n.F.",
      blurb: "Brennhollow wuchs, und mit ihm der Ruf seiner Wächterin. Doch wer in der Aschmark Mauern baut, wird in Kaldris gezählt: Der König prüft seine Getreuen, und jeder Hof hat sein Messer.",
      voice: Some("narrator.age_age2_a"),
      missions: [
        (id: "m04_long_night", needs: ["m03_grey_road"], if_flags: [], unless_flags: [], finale: false, pos: (0.46, 0.68)),
        (id: "m06_tourney_kaldris", needs: ["m04_long_night"], if_flags: [], unless_flags: [], finale: false, pos: (0.5, 0.44)),
        (id: "m07_iron_hills", needs: ["m06_tourney_kaldris"], if_flags: [], unless_flags: [], finale: false, pos: (0.32, 0.48)),
      ],
    ),
    (
      id: "age3",
      numeral: "III",
      title: "Die gebrochenen Grenzen",
      subtitle: "The Broken Borders",
      years: "905–907 n.F.",
      blurb: "Die Hohlen griffen nicht mehr in Wellen an, sondern wie ein Heer, das einen Plan verfolgt. An drei Grenzen brachen die Mauern – und die alten Feinde mussten lernen, einander zuzuhören.",
      voice: Some("narrator.age_age3_a"),
      missions: [
        (id: "m09_black_winter", needs: ["m07_iron_hills"], if_flags: [], unless_flags: [], finale: false, pos: (0.52, 0.16)),
        (id: "m10_root_and_ash", needs: ["m09_black_winter"], if_flags: [], unless_flags: [], finale: false, pos: (0.16, 0.38)),
        (id: "m11_marrowfen_rift", needs: ["m10_root_and_ash"], if_flags: [], unless_flags: [], finale: false, pos: (0.22, 0.82)),
      ],
    ),
    (
      id: "age4",
      numeral: "IV",
      title: "Das Zeitalter der Eroberung",
      subtitle: "The Age of Conquest",
      years: "910–912 n.F.",
      blurb: "Aus der Verteidigerin wurde eine Eroberin. Die Aschglasfelder lockten Legion und Händler zugleich, und an der Küste wartete etwas, das nicht ertrunken war, sondern wartete.",
      voice: Some("narrator.age_age4_a"),
      missions: [
        (id: "m13_ashglass_fields", needs: ["m11_marrowfen_rift"], if_flags: [], unless_flags: [], finale: false, pos: (0.7, 0.72)),
        (id: "m14_black_reef", needs: ["m13_ashglass_fields"], if_flags: [], unless_flags: [], finale: false, pos: (0.84, 0.5)),
      ],
    ),
    (
      id: "age5",
      numeral: "V",
      title: "Der geteilte Thron",
      subtitle: "The Divided Throne",
      years: "916–917 n.F.",
      blurb: "Der König war alt, und der Thron hat keine Freunde. In Kaldris wurden Zeugen leise und Glocken laut – und Isolde stand in der Mitte, mit dem Schwert in der einen und dem Gesetz in der anderen Hand.",
      voice: Some("narrator.age_age5_a"),
      missions: [
        (id: "m17_death_of_a_king", needs: ["m14_black_reef"], if_flags: [], unless_flags: [], finale: false, pos: (0.6, 0.34)),
        (id: "m19_kaldris_ford", needs: ["m17_death_of_a_king"], if_flags: [], unless_flags: [], finale: false, pos: (0.68, 0.46)),
      ],
    ),
    (
      id: "age6",
      numeral: "VI",
      title: "Die gefallenen Götter",
      subtitle: "The Fallen Gods",
      years: "920–922 n.F.",
      blurb: "Die Götter schwiegen seit dem Aschenfall. Nun regten sich Altäre unter Bergen und Ruinen, und mit ihnen erwachte, was die Götter einst gebunden hatten – und was sich an ihrer Stelle genährt hatte.",
      voice: Some("narrator.age_age6_a"),
      missions: [
        (id: "m21_shrine_oruun", needs: ["m19_kaldris_ford"], if_flags: [], unless_flags: [], finale: false, pos: (0.64, 0.2)),
        (id: "m25_ithren_light", needs: ["m21_shrine_oruun"], if_flags: [], unless_flags: [], finale: false, pos: (0.44, 0.88)),
      ],
    ),
    (
      id: "age7",
      numeral: "VII",
      title: "Die letzte Krone",
      subtitle: "The Last Crown",
      years: "923 n.F.",
      blurb: "Das Hohle Tief erwachte nicht aus eigener Kraft: Es hatte immer einen Schlüssel. Brennhollow brannte noch einmal, und dann zog ein Bund aus Fahnen und Feuern nach Solmere, wo ein toter König auf seinem Thron wartete.",
      voice: Some("narrator.age_age7_a"),
      missions: [
        (id: "m26_ashen_march", needs: ["m25_ithren_light"], if_flags: [], unless_flags: [], finale: false, pos: (0.4, 0.78)),
        (id: "m28_gates_of_solmere", needs: ["m26_ashen_march"], if_flags: [], unless_flags: [], finale: false, pos: (0.6, 0.84)),
        (id: "m29_hollow_throne", needs: ["m28_gates_of_solmere"], if_flags: [], unless_flags: [], finale: true, pos: (0.7, 0.92)),
      ],
    ),
  ],
  endings: [
    (
      id: "end_redeem",
      title: "Erlösung",
      text: "Varkhan Aurelith sprach zum ersten Mal seit tausend Jahren den Namen seiner Tochter – und das Tiefe verlor seinen Schlüssel. Es wurde still in Solmere, und im Frühjahr blühte in der Aschmark der erste Apfelbaum seit dem Fall.",
      requires: [
        "final_redeem",
      ],
      voice: Some("narrator.age_ende_a"),
    ),
    (
      id: "end_destroy",
      title: "Das Ende der Glut",
      text: "Das Feuer, das Isolde in Solmere entfachte, brannte neun Tage lang. Das Tiefe wich zurück, doch die Wunden der Welt blieben offen – und die Glut der Wächterin erlosch mit ihnen.",
      requires: [
        "final_destroy",
      ],
      voice: Some("narrator.age_ende_b"),
    ),
    (
      id: "end_crown",
      title: "Die Aschenkrone",
      text: "So wurde die letzte Krone Eldraeths aus Asche geschmiedet. Die Toten hielten Wache an jeder Grenze, und kein Dorf brannte mehr. Doch nachts, in den Hallen von Solmere, sprach die neue Herrin manchmal mit jemandem, den niemand sah.",
      requires: [
        "final_crown",
      ],
      voice: Some("narrator.age_ende_c"),
    ),
    (
      id: "end_seal",
      title: "Das versiegelte Tor",
      text: "Und so wurde der Schleier geschlossen. Niemand krönte die Wächterin der Aschmark. Aber in Brennhollow brennt seither jede Nacht ein Feuer, und niemand hat es je erlöschen lassen.",
      requires: [],
      voice: Some("narrator.age_ende_d"),
    ),
  ],
)
