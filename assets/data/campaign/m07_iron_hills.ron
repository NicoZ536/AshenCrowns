  objectives: [
    (id: "obj_gate", text: "Brecht das Südtor von Kargsted.", optional: false),
    (id: "obj_keep", text: "Nehmt den Bergfried von Kargsted ein.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "lager", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Eisen war in der Aschmark kostbarer als Brot. Wer die Schmiede befeuern wollte, musste durch Kargsted – und Kargsted hatte Mauern, die ein Schwarm Toter nie gebraucht hätte.", voice: Some("narrator.m07_lager_a")), (speaker: "Isolde Raventhorn", text: "Die Rammen zuerst ans Tor, die Katapulte auf die Eckschützen. Wer die Mauer mit der Brust einreißen will, lernt es heute auf die harte Weise.", voice: Some("hero_isolde.m07_lager_b"))]), AddObjective("obj_gate"), AddObjective("obj_keep"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn belagerte die Steinfeste Kargsted.")], modes: []),
    (id: "tor", condition: Any([TagDamaged("kargsted_keep")]), actions: [CompleteObjective("obj_gate"), Dialogue([(speaker: "Isolde Raventhorn", text: "Das Tor ist gebrochen! Schildträger vor, Schützen nach – keine Gefangenen, aber lasst die Bauern am Leben!", voice: Some("hero_isolde.m07_tor_a"))])], modes: []),
    (id: "sieg", condition: TagDead("kargsted_keep"), actions: [CompleteObjective("obj_keep"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Bruder Hal Venn", text: "Eisen. Wirkliches Eisen. Ich muss es dir lassen, Isolde: Du verstehst, wann man eine Mauer überredet und wann man sie einreißt.", voice: Some("char_hal_venn.m07_sieg_a"))]), Chronicle("Kargsted fiel, und mit ihm das Eisenmonopol der Raubritter."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel vor den Mauern von Kargsted.", voice: None), Defeat], modes: []),
  ],
