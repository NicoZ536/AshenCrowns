  starts: [
    (owner: 0, x: 14.0, y: 62.0),
    (owner: 1, x: 59.0, y: 42.0),
  ],
  briefing: "Kargsted, Jahr 902 n.F. Brennhollows Schmieden verlangen Eisen, und das einzige gute Erz der Gegend liegt unter der Steinfeste Kargsted, die ein Raubritter mit eigener Garnison hält. Ihr führt eine echte Belagerung: drei Rammböcke, zwei Katapulte, Fußvolk und Schützen. Das Tor im Süden ist die schwächste Stelle, die Türme an den Ecken tragen Schützen. Brecht das Tor mit den Rammen, haltet die Schützen mit den Katapulten nieder und nehmt den Bergfried der Feste.",
  author: "Ashen Crowns",
  year: Some(902),
  unit_cap: None,
  start_time: Some(0.4),
  free_economy: true,
  kind: "Belagerung",
  victory_text: "Das Tor von Kargsted fiel, und mit ihm die Hoffnung des Raubritters. In den Schmieden von Brennhollow brannte noch in derselben Nacht das erste Feuer mit eigenem Eisen.",
  defeat_text: "Der Sturm auf Kargsted scheiterte. Die Rammen brannten, und der Raubritter lachte über die Mauern.",
  intro_chronicle: "",
  chronicle_title: "Eisen in den Hügeln",
