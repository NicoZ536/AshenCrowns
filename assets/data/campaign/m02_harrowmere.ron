  starts: [
    (owner: 0, x: 12.0, y: 56.0),
    (owner: 1, x: 30.0, y: 50.0),
  ],
  briefing: "Aschmoor, Jahr 897 n.F. Wenige Tage nach dem Fall des Hohlschreins von Vael Dorn kommt ein Reiter aus dem Süden: Harrowmere, das Dorf im Moor, wird von den Hohlen überrannt. Wer noch gehen kann, hat sich am Brunnen gesammelt. Ihr führt sechzehn Überlebende und eine kleine Eskorte unter Isolde Raventhorn. Die alte Straße windet sich nordostwärts durch das Moor, über eine Furt und an drei Wachlagern der Hohlen vorbei. Bringt mindestens elf Menschen nach Brennhollow. Ascheregen verschluckt Geräusche – die Toten kommen oft zuerst als Schatten. Nach der Ankunft steht noch eine Entscheidung an, die Brennhollow prägen wird.",
  author: "Ashen Crowns",
  year: Some(897),
  unit_cap: None,
  start_time: Some(0.34),
  kind: "Eskorte",
  victory_text: "Die Fackeln von Brennhollow nahmen die Erschöpften auf. Harrowmere aber blieb im Moor zurück – ein Name mehr in der Liste der Verlorenen.",
  defeat_text: "Das Moor schloss sich über dem Zug der Flüchtlinge. Niemand aus Harrowmere erreichte Brennhollow.",
  intro_chronicle: "",
  chronicle_title: "Die Flüchtlinge von Harrowmere",
  variants: [
    (requires: ["core_kept"], forbids: [], note: "Der geborgene Aschglas-Kern lässt zwei Kampfmagier der Flamme ihre Kraft mit der Eskorte teilen.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "battle_mage", owner: 0, x: 11.5, y: 61.0, count: 2, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
