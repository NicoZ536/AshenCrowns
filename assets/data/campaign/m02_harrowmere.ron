(
  id: "m02_harrowmere",
  name: "Die Flüchtlinge von Harrowmere",
  description: "Harrowmere im Aschmoor brennt. Führt die Überlebenden über Furt und Moorstraße nach Brennhollow – keine Wagen zurücklassen, kein Kind.",
  map_seed: 89702,
  start_resources: (
