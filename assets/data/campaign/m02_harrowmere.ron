  objectives: [
    (id: "obj_escort", text: "Führt mindestens elf Überlebende von Harrowmere nach Brennhollow.", optional: false),
    (id: "obj_ford", text: "Überquert die Furt im Aschmoor.", optional: true),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "kern", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Bruder Hal Venn", text: "Das Feuer ist aus, aber die Steine sind noch warm. Das ist nicht natürlich, Isolde.", voice: Some("char_hal_venn.m02_kern_a")), (speaker: "Isolde Raventhorn", text: "Nichts an diesem Ort ist natürlich. Sieh dir den Kristall an. Er … atmet.", voice: Some("hero_isolde.m02_kern_b")), (speaker: "Die Stimme aus dem Tief", text: "Wächterin … du hast meine kleine Glocke zerbrochen. Wie unhöflich.", voice: Some("char_deep_voice.m02_kern_c")), (speaker: "Isolde Raventhorn", text: "Hal. Sag mir, dass du das gehört hast.", voice: Some("hero_isolde.m02_kern_d")), (speaker: "Bruder Hal Venn", text: "Was gehört? Isolde, deine Hand zittert. Geh weg davon.", voice: Some("char_hal_venn.m02_kern_e")), (speaker: "Die Stimme aus dem Tief", text: "Er kann mich nicht hören. Nur wer im Fieber gebrannt hat, kann es. Erinnerst du dich an das Fieber, Kind? Ich erinnere mich an dich.", voice: Some("char_deep_voice.m02_kern_f"))]), Decision((id: "core", speaker: "Bruder Hal Venn", title: "Der Aschglas-Kern", text: "Dieses Aschglas könnte uns verraten, wie der Schrein erbaut wurde. Oder es ist das Letzte, was wir je untersuchen. Deine Wahl, Wächterin.", voice: Some("char_hal_venn.m02_kern_g"), options: [(flag: "core_smashed", label: "Den Kern zerschlagen", detail: "Nichts bleibt zurück, was das Tiefe nutzen könnte.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Nein. Was immer darin ist, es kennt meinen Namen. Zerschlagt es.", voice: Some("hero_isolde.m02_kern_a_a")), (speaker: "Die Stimme aus dem Tief", text: "Zerbrich das Glas, kleine Flamme. Unter dir ist so viel mehr von mir.", voice: Some("char_deep_voice.m02_kern_a_b")), (speaker: "Bruder Hal Venn", text: "Gut. Manches Wissen bleibt besser in der Asche.", voice: Some("char_hal_venn.m02_kern_a_c"))])]), (flag: "core_kept", label: "Den Kern bergen und erforschen", detail: "Brennhollow gewinnt Kampfmagier – und die Stimme bleibt in Reichweite.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Wir nehmen es mit. Wenn wir nicht verstehen, wogegen wir kämpfen, haben wir schon verloren.", voice: Some("hero_isolde.m02_kern_b_a")), (speaker: "Die Stimme aus dem Tief", text: "Ja … trag mich heim. Halte mich nah an deinem Feuer.", voice: Some("char_deep_voice.m02_kern_b_b")), (speaker: "Bruder Hal Venn", text: "Dann schläft es unter der Kapelle, in Eisen gehüllt, und ich bete jede Nacht darüber.", voice: Some("char_hal_venn.m02_kern_b_c"))])])]))], modes: []),
    (id: "aufbruch", condition: Any([Flag("core_smashed"), Flag("core_kept")]), actions: [Dialogue([(speaker: "Erzähler", text: "Drei Tage nach dem Fall des Schreins kam ein Reiter aus dem Süden. Harrowmere, das Dorf im Aschmoor, brenne. Wer noch gehen könne, warte am Brunnen – auf ein Wunder oder auf jemanden, der keines verspreche.", voice: Some("narrator.m02_aufbruch_a")), (speaker: "Isolde Raventhorn", text: "Wir führen sie nach Brennhollow. Kein Wagen bleibt zurück, kein Kind. Bleibt auf der Straße, und wenn der Ascheregen fällt, bleibt zusammen.", voice: Some("hero_isolde.m02_aufbruch_b"))]), AddObjective("obj_escort"), AddObjective("obj_ford"), AddObjective("obj_hero"), SetWeather(Ashfall), Chronicle("Der Zug der Flüchtlinge von Harrowmere brach nach Brennhollow auf.")], modes: []),
    (id: "jagd1", condition: All([Any([Flag("core_smashed"), Flag("core_kept")]), AtTime(90.0)]), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 8, attack: true, tag: None)], modes: []),
    (id: "jagd2", condition: All([Any([Flag("core_smashed"), Flag("core_kept")]), AtTime(165.0)]), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 6, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "dorf", count: 2, attack: true, tag: None)], modes: []),
    (id: "jagd3", condition: All([Any([Flag("core_smashed"), Flag("core_kept")]), AtTime(250.0)]), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 8, attack: true, tag: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "dorf", count: 1, attack: true, tag: None)], modes: []),
    (id: "furt", condition: UnitsInArea(area: "furt", count: 3), actions: [CompleteObjective("obj_ford"), Dialogue([(speaker: "Isolde Raventhorn", text: "Das Wasser reicht bis zu den Knien. Tragt die Kinder, und redet nicht – das Moor hört zu.", voice: Some("hero_isolde.m02_furt_a"))])], modes: []),
    (id: "hinterhalt", condition: UnitsInArea(area: "hinterhalt", count: 1), actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Im Röhricht, links! Schließt die Reihen, die Schwachen in die Mitte!", voice: Some("hero_isolde.m02_hinterhalt_a"))]), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flanke", count: 4, attack: true, tag: None)], modes: []),
    (id: "verloren", condition: All([AtTime(10.0), Not(UnitCount(unit: "worker", count: 9))]), actions: [Message(speaker: "Erzähler", text: "Zu wenige erreichten Brennhollow. Das Moor behielt seine Toten.", voice: None), Defeat], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel im Moor, und mit ihr die letzte Hoffnung des Zuges.", voice: None), Defeat], modes: []),
    (id: "ankunft", condition: UnitKindInArea(unit: "worker", area: "brennhollow", count: 11), actions: [CompleteObjective("obj_escort"), Dialogue([(speaker: "Bruder Hal Venn", text: "Die Tore auf! Öffnet die Tore – Wasser, Decken, Brot! Sie leben, Isolde. Sie leben.", voice: Some("char_hal_venn.m02_ankunft_a")), (speaker: "Nel", text: "Der Mann im Moor hat gesagt, ich soll dir ausrichten: Es war nett, dich kennenzulernen.", voice: Some("char_nel.m02_ankunft_b")), (speaker: "Isolde Raventhorn", text: "Welcher Mann, Nel?", voice: Some("hero_isolde.m02_ankunft_c"))]), Decision((id: "nel", speaker: "Bruder Hal Venn", title: "Das Mädchen Nel", text: "Das Kind hört etwas, das uns nicht hört. Wir können es bei uns behalten und wachen – oder es den Flammenschwestern in Kaldris anvertrauen.", voice: Some("char_hal_venn.m02_ankunft_d"), options: [(flag: "nel_sheltered", label: "Nel in Brennhollow aufnehmen", detail: "Nel kann das Tiefe später „hören“ – und wird zur Zielscheibe.", requires: [], actions: [Dialogue([(speaker: "Bruder Hal Venn", text: "Dann bleibt sie bei uns, und ich werde ihre Träume bewachen. Die Flamme verzeiht eher Mut als Furcht.", voice: Some("char_hal_venn.m02_nel_a_a")), (speaker: "Nel", text: "Danke. Hier ist es warm.", voice: Some("char_nel.m02_nel_a_b"))])]), (flag: "nel_sent", label: "Nel nach Kaldris schicken", detail: "Sie ist sicher, doch ihre Gabe bleibt ungenutzt.", requires: [], actions: [Dialogue([(speaker: "Bruder Hal Venn", text: "Die Flammenschwestern in Kaldris kennen Kinder wie sie. Es ist vernünftig – und es bricht mir das Herz.", voice: Some("char_hal_venn.m02_nel_b_a")), (speaker: "Nel", text: "Kommst du mich besuchen?", voice: Some("char_nel.m02_nel_b_b"))])])]))], modes: []),
    (id: "sieg", condition: Any([Flag("nel_sheltered"), Flag("nel_sent")]), actions: [Dialogue([(speaker: "Erzähler", text: "Sechzehn Menschen mehr in Brennhollow, und kein Vorrat für sie. Doch an diesem Abend zählte niemand nach: Es brannten zwei Feuer mehr auf dem Marktplatz als am Morgen.", voice: Some("narrator.m02_sieg_a"))]), Chronicle("Die Überlebenden von Harrowmere fanden Zuflucht in Brennhollow."), Victory], modes: []),
  ],
