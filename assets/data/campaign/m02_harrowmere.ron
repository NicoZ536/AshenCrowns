    (id: "brennhollow", name: "Das Tor von Brennhollow", x: 78, y: 5, w: 16, h: 20),
    (id: "furt", name: "Die Furt", x: 44, y: 43, w: 8, h: 7),
    (id: "hinterhalt", name: "Hinterhalt im Moor", x: 36, y: 44, w: 7, h: 7),
