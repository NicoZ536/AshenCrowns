  ],
  starts: [
    (owner: 0, x: 10.0, y: 78.0),
    (owner: 1, x: 44.0, y: 42.0),
  ],
  briefing: "Marrowfen, Jahr 907 n.F. Im Moor ist ein Riss aufgegangen, schmal wie ein Fingernagel und tief wie die Nacht. Aus ihm quellen Schleiergeister und Fledermausschwärme, und in drei Weilern harren Dorfbewohner aus, die nicht fliehen konnten. Ihr führt Isolde und Hal Venn mit einem kleinen Trupp: Erreicht die Weiler, nehmt die Menschen mit und bringt sie über den Damm im Nordosten. Der Riss selbst ist reich an Aschglas – und die Stimme aus dem Tief macht ein Angebot. Entscheidet, ob Ihr den Riss schließt oder anzapft. Mindestens acht Menschen müssen den Damm erreichen.",
  author: "Ashen Crowns",
  year: Some(907),
  unit_cap: None,
  start_time: Some(0.52),
  kind: "Rettung",
  victory_text: "Der Damm von Marrowfen trug die Geretteten ins Trockene. Hinter ihnen schloss oder öffnete sich das Moor, je nachdem, wen man fragte.",
  defeat_text: "Marrowfen versank im Schleier. Wer den Damm nicht erreichte, kehrte nicht wieder.",
  intro_chronicle: "",
  chronicle_title: "Der Riss von Marrowfen",
  variants: [
    (requires: ["nel_sheltered"], forbids: [], note: "Nel hört den Riss und führt den Trupp am Hinterhalt im Schilf vorbei.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: ["wk_ambush"], placements: [], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
    (requires: ["rootmother_pact"], forbids: [], note: "Der Dornenbund schickt Waldläufer, die das Moor kennen.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "archer", owner: 0, x: 7.0, y: 79.0, count: 4, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
