    (id: "priest", owner: 0, x: 13.5, y: 78.5, count: 2, tag: None, guard: false, camp: None),
    (id: "worker", owner: 2, x: 14.0, y: 40.0, count: 5, tag: Some("dorf1"), guard: false, camp: None),
    (id: "worker", owner: 2, x: 30.0, y: 74.0, count: 5, tag: Some("dorf2"), guard: false, camp: None),
    (id: "worker", owner: 2, x: 70.0, y: 58.0, count: 5, tag: Some("dorf3"), guard: false, camp: None),
    (id: "hollow_thrall", owner: 1, x: 16.0, y: 38.0, count: 3, tag: None, guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 28.5, y: 72.0, count: 3, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 68.0, y: 56.0, count: 4, tag: None, guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 36.5, y: 52.0, count: 3, tag: Some("wk_ambush"), guard: true, camp: None),
    (id: "ash_witch", owner: 1, x: 46.0, y: 46.0, count: 2, tag: Some("riss_wache"), guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 48.0, y: 40.0, count: 3, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 41.0, y: 40.0, count: 4, tag: None, guard: true, camp: None),
    (id: "hollow_shrine", owner: 1, x: 43.0, y: 41.0, count: 0, tag: Some("rift"), guard: false, camp: None),
    (id: "hollow_archer", owner: 1, x: 56.0, y: 28.0, count: 3, tag: None, guard: true, camp: None),
  ],
  objectives: [
    (id: "obj_rescue", text: "Rettet mindestens acht Dorfbewohner über den Damm im Nordosten.", optional: false),
    (id: "obj_rift", text: "Entscheidet über den Riss von Marrowfen.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "moor", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "In Marrowfen riecht es nach nasser Asche und nach Dingen, die zu lange unter Wasser geschlafen haben. Wo der Riss aufgegangen war, wuchs kein Schilf mehr – nur ein weißer Ring aus Knochenstaub.", voice: Some("narrator.m11_moor_a")), (speaker: "Bruder Hal Venn", text: "Drei Weiler, Isolde. Wenn wir schnell sind, schaffen wir alle drei vor der Dämmerung. Und wenn wir langsam sind … schaffen wir es gar nicht.", voice: Some("char_hal_venn.m11_moor_b"))]), AddObjective("obj_rescue"), AddObjective("obj_rift"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn zog nach Marrowfen, um den Riss zu schließen.")], modes: []),
    (id: "dorf1", condition: UnitsInArea(area: "dorf1", count: 1), actions: [ChangeOwner(tag: "dorf1", owner: 0), Dialogue([(speaker: "Bruder Hal Venn", text: "Kommt, kommt – langsam, haltet euch an den Händen. Wir bringen euch über den Damm, im Namen der Flamme!", voice: Some("char_hal_venn.m11_dorf_a"))])], modes: []),
    (id: "dorf2", condition: UnitsInArea(area: "dorf2", count: 1), actions: [ChangeOwner(tag: "dorf2", owner: 0)], modes: []),
    (id: "dorf3", condition: UnitsInArea(area: "dorf3", count: 1), actions: [ChangeOwner(tag: "dorf3", owner: 0)], modes: []),
    (id: "riss1", condition: All([AtTime(70.0), Not(Flag("rift_harvested")), Not(TagDead("rift"))]), actions: [SpawnUnits(unit: "bat_swarm", owner: 1, area: "riss", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "riss", count: 4, attack: true, tag: None)], modes: []),
    (id: "riss2", condition: All([AtTime(130.0), Not(Flag("rift_harvested")), Not(TagDead("rift"))]), actions: [SpawnUnits(unit: "ghoul", owner: 1, area: "riss", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "riss", count: 3, attack: true, tag: None)], modes: []),
    (id: "riss3", condition: All([AtTime(200.0), Not(Flag("rift_harvested")), Not(TagDead("rift"))]), actions: [SpawnUnits(unit: "bat_swarm", owner: 1, area: "riss", count: 4, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "riss", count: 3, attack: true, tag: None)], modes: []),
    (id: "riss4", condition: All([AtTime(280.0), Not(Flag("rift_harvested")), Not(TagDead("rift"))]), actions: [SpawnUnits(unit: "ash_witch", owner: 1, area: "riss", count: 1, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "riss", count: 6, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "riss", count: 3, attack: true, tag: None)], modes: []),
    (id: "riss", condition: TagDiscovered("rift"), actions: [Dialogue([(speaker: "Die Stimme aus dem Tief", text: "Du bist weit gekommen, kleine Flamme. Sieh, was ich dir zeige: Aschglas, so rein, dass es singt. Nimm davon, und deine Heere werden nie wieder hungern.", voice: Some("char_deep_voice.m11_riss_a")), (speaker: "Bruder Hal Venn", text: "Hör nicht hin, Isolde. Was dort flüstert, hat Harrowmere verbrannt.", voice: Some("char_hal_venn.m11_riss_b"))]), Decision((id: "rift", speaker: "Bruder Hal Venn", title: "Der Riss von Marrowfen", text: "Der Riss kann geschlossen werden, wenn wir den Schrein an seinem Grund zerschlagen. Oder wir nehmen, was er uns reicht – und tragen die Folgen.", voice: Some("char_hal_venn.m11_riss_c"), options: [(flag: "rift_sealed", label: "Den Riss versiegeln", detail: "Der Schrein muss zerstört werden; die Hohlung bleibt fern.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Du bietest mir Brot, aus dem Mund eines Hungernden. Nein. Hal, schließ ihn.", voice: Some("hero_isolde.m11_riss_a_a")), (speaker: "Die Stimme aus dem Tief", text: "Wie schade. Ich hatte mich gefreut, dich zu verwöhnen.", voice: Some("char_deep_voice.m11_riss_a_b"))])]), (flag: "rift_harvested", label: "Das Aschglas ernten", detail: "Reiche Beute – aber das Tiefe bleibt in Reichweite und die Hohlung wächst.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Nur ein wenig. Nur so viel, wie die Aschmark in zehn Wintern verbraucht.", voice: Some("hero_isolde.m11_riss_b_a")), (speaker: "Die Stimme aus dem Tief", text: "Ein wenig. Natürlich. Ich bin geduldig, Kind. Ich war es immer.", voice: Some("char_deep_voice.m11_riss_b_b"))]), Grant((gold: 600.0, wood: 300.0, stone: 300.0, food: 300.0))])]))], modes: []),
    (id: "nel_weg", condition: All([Flag("nel_sheltered"), AtTime(8.0)]), actions: [Dialogue([(speaker: "Nel", text: "Hört ihr es? Es klingt wie eine Spieluhr, die jemand zu langsam aufzieht. Dort entlang geht es – das Schilf weiß den Weg.", voice: Some("char_nel.m11_nel_a"))])], modes: []),
    (id: "sieg_sealed", condition: All([Flag("rift_sealed"), TagDead("rift"), UnitKindInArea(unit: "worker", area: "damm", count: 8)]), actions: [CompleteObjective("obj_rescue"), CompleteObjective("obj_rift"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Der Damm trug die Geretteten ins Trockene. Hinter ihnen schloss sich das Moor – oder öffnete sich, je nachdem, wen man später fragte.", voice: Some("narrator.m11_sieg_a"))]), Chronicle("Der Riss von Marrowfen wurde versiegelt."), Victory], modes: []),
    (id: "sieg_harvest", condition: All([Flag("rift_harvested"), UnitKindInArea(unit: "worker", area: "damm", count: 8)]), actions: [CompleteObjective("obj_rescue"), CompleteObjective("obj_rift"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Der Damm trug die Geretteten ins Trockene. Hinter ihnen schloss sich das Moor – oder öffnete sich, je nachdem, wen man später fragte.", voice: Some("narrator.m11_sieg_a"))]), Chronicle("Aschglas aus Marrowfen füllte die Wagen der Aschmark."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel im Moor von Marrowfen.", voice: None), Defeat], modes: []),
  ],
