(
  id: "m11_marrowfen_rift",
  name: "Der Riss von Marrowfen",
  description: "Aus dem Moor von Marrowfen strömen Schleiergeister. Rettet die Dorfbewohner, führt sie über den Damm – und entscheidet, ob der Riss versiegelt oder geerntet wird.",
  map_seed: 90711,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 0.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
    interval_day: 150.0,
    interval_night: 95.0,
    base_budget: 3.0,
    budget_per_wave: 1.7,
    night_mult: 1.5,
  ),
  placements: [
    (id: "hero_isolde", owner: 0, x: 10.0, y: 78.5, count: 0, tag: Some("hero"), guard: false, camp: None),
    (id: "hero_hal_venn", owner: 0, x: 12.0, y: 77.0, count: 0, tag: Some("hero_hal"), guard: false, camp: None),
