(
  id: "m06_tourney_kaldris",
  name: "Das Turnier von Kaldris",
  description: "Im Turnier der Glutkrone besteht Ihr die Zweikämpfe – und in der Nacht danach jagt Ihr die Attentäter, bevor sie das Tor der Flucht erreichen.",
  map_seed: 90106,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 0.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
    interval_day: 150.0,
    interval_night: 95.0,
    base_budget: 3.0,
    budget_per_wave: 1.7,
    night_mult: 1.5,
  ),
  placements: [
    (id: "hero_isolde", owner: 0, x: 8.0, y: 32.5, count: 0, tag: Some("hero"), guard: false, camp: None),
    (id: "swordsman", owner: 0, x: 6.0, y: 31.0, count: 3, tag: None, guard: false, camp: None),
    (id: "scout_rider", owner: 0, x: 5.0, y: 34.5, count: 3, tag: None, guard: false, camp: None),
    (id: "horse_archer", owner: 0, x: 8.5, y: 35.5, count: 2, tag: None, guard: false, camp: None),
    (id: "archer", owner: 0, x: 6.5, y: 29.0, count: 2, tag: None, guard: false, camp: None),
  ],
  objectives: [
    (id: "obj_duel1", text: "Besteht die erste Zweikampfrunde.", optional: false),
    (id: "obj_duel2", text: "Besteht die zweite Zweikampfrunde.", optional: false),
    (id: "obj_assassins", text: "Stellt die drei Attentäter, bevor einer das Tor der Flucht erreicht.", optional: false),
  ],
  triggers: [
    (id: "turnier", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Kaldris trug Gold und Weiß. Über der Arena hingen die Banner der zwölf Herzogtümer, und auf der Tribüne saß ein alternder König, der aussah, als warte er auf etwas, das nicht der Sieger war.", voice: Some("narrator.m06_turnier_a")), (speaker: "Kassian Vale", text: "Eine Beobachtung, Wächterin, ganz unverbindlich: Heute Abend wird der Balkon der Krone nicht jeden verlassen, der ihn betritt. Ich überlasse es Euch, was Ihr mit diesem Wissen anfangt.", voice: Some("char_kassian.m06_turnier_b"))]), AddObjective("obj_duel1"), AddObjective("obj_duel2"), AddObjective("obj_assassins"), Chronicle("Isolde Raventhorn trat beim Turnier der Glutkrone an.")], modes: []),
    (id: "runde1", condition: AtTime(14.0), actions: [SpawnUnits(unit: "swordsman", owner: 1, area: "arena", count: 4, attack: true, tag: None), SpawnUnits(unit: "spearman", owner: 1, area: "arena", count: 2, attack: true, tag: None)], modes: []),
    (id: "runde1_ok", condition: All([AtTime(20.0), EnemyUnitsAtMost(0)]), actions: [CompleteObjective("obj_duel1"), Dialogue([(speaker: "König Aldric III.", text: "Die Wächterin der Aschmark! Man erzählt, sie schlage die Besten, ohne zu schwitzen. Zeigt es uns noch einmal!", voice: Some("char_king_aldric.m06_runde2_a"))])], modes: []),
    (id: "runde2", condition: All([ObjectiveCompleted("obj_duel1"), AtTime(40.0)]), actions: [SpawnUnits(unit: "swordsman", owner: 1, area: "arena", count: 4, attack: true, tag: None), SpawnUnits(unit: "archer", owner: 1, area: "arena", count: 2, attack: true, tag: None), SpawnUnits(unit: "knight", owner: 1, area: "arena", count: 1, attack: true, tag: None)], modes: []),
    (id: "runde2_ok", condition: All([ObjectiveCompleted("obj_duel1"), AtTime(60.0), EnemyUnitsAtMost(0)]), actions: [CompleteObjective("obj_duel2")], modes: []),
    (id: "glocke", condition: ObjectiveCompleted("obj_duel2"), actions: [Dialogue([(speaker: "Erzähler", text: "Es war das Läuten der Abendglocke, das ihn rettete: ein falscher Ton, eine Sekunde zu früh. Auf dem Balkon der Krone regte sich ein Schatten, dann zwei, dann drei.", voice: Some("narrator.m06_glocke_a"))]), SetFlag("glocke")], modes: []),
    (id: "anschlag", condition: All([Flag("glocke"), DialogueDone]), actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Dort oben! Die Reiter voran – holt sie ein, bevor sie die Gassen erreichen!", voice: Some("hero_isolde.m06_anschlag_a"))]), SpawnUnits(unit: "worker", owner: 1, area: "balkon1", count: 1, attack: false, tag: Some("assassin1")), SpawnUnits(unit: "worker", owner: 1, area: "balkon2", count: 1, attack: false, tag: Some("assassin2")), SpawnUnits(unit: "worker", owner: 1, area: "balkon3", count: 1, attack: false, tag: Some("assassin3")), MoveTag(tag: "assassin1", area: "flucht", attack: false), MoveTag(tag: "assassin2", area: "flucht", attack: false), MoveTag(tag: "assassin3", area: "flucht", attack: false)], modes: []),
    (id: "verloren", condition: Any([TagInArea(tag: "assassin1", area: "flucht"), TagInArea(tag: "assassin2", area: "flucht"), TagInArea(tag: "assassin3", area: "flucht")]), actions: [Message(speaker: "Erzähler", text: "Ein Mörder erreichte das Tor. Zu spät.", voice: None), Defeat], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel in den Gassen von Kaldris.", voice: None), Defeat], modes: []),
    (id: "gestellt", condition: All([TagDead("assassin1"), TagDead("assassin2"), TagDead("assassin3")]), actions: [CompleteObjective("obj_assassins"), Decision((id: "kassian_secret", speaker: "Kassian Vale", title: "Kassians Geheimnis", text: "Nun wisst Ihr, dass ich es wusste. Was macht Ihr damit, Wächterin: Sagt Ihr es dem König, behaltet Ihr es als Pfand – oder schweigt Ihr?", voice: Some("char_kassian.m06_ende_a"), options: [(flag: "kassian_warned_king", label: "Dem König die Wahrheit sagen", detail: "Aldric steht Euch bei; Kassian wird zum Feind.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Majestät, ein Wort unter vier Augen: Es gab eine Warnung, und sie war nicht ohne Eigennutz.", voice: Some("hero_isolde.m06_kassian_a_a")), (speaker: "König Aldric III.", text: "Ihr habt mir das Leben gerettet und das Spiel verdorben. Ich weiß nicht, was mich mehr bewegt.", voice: Some("char_king_aldric.m06_kassian_a_b"))])]), (flag: "kassian_leverage", label: "Das Wissen als Pfand behalten", detail: "Kassian schuldet Euch einen Gefallen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Kassian. Ihr habt mehr gewusst, als Ihr gesagt habt. Dafür schuldet Ihr mir etwas.", voice: Some("hero_isolde.m06_kassian_b_a")), (speaker: "Kassian Vale", text: "So ist es. Es ist angenehm, wenn jemand begreift, dass Wissen eine Währung ist. Ich werde zahlen, wenn die Stunde kommt.", voice: Some("char_kassian.m06_kassian_b_b"))])]), (flag: "kassian_silent", label: "Schweigen", detail: "Keine Verpflichtung, keine Verbündeten.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Es war ein Anschlag, mehr nicht. Ich habe nichts gesehen, was zu erzählen wäre.", voice: Some("hero_isolde.m06_kassian_c_a")), (speaker: "Kassian Vale", text: "Wie diskret. Ich bin beinahe enttäuscht – und beeindruckt.", voice: Some("char_kassian.m06_kassian_c_b"))])])]))], modes: []),
    (id: "sieg", condition: Any([Flag("kassian_warned_king"), Flag("kassian_leverage"), Flag("kassian_silent")]), actions: [Chronicle("Der Anschlag auf König Aldric III. wurde vereitelt."), Victory], modes: []),
  ],
