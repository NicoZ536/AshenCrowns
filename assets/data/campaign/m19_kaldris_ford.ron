  objectives: [
    (id: "obj_side", text: "Wählt Partei im Erbfolgekrieg.", optional: false),
    (id: "obj_win", text: "Besiegt das Heer des Feindes an der Furt.", optional: false),
    (id: "obj_marshal", text: "Erschlagt den Marschall der Legion.", optional: true),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "thron", condition: AtTime(1.0), actions: [Dialogue([(speaker: "König Aldric III.", text: "Isolde. Kommt näher. Meine Augen … sind nicht mehr, was sie waren.", voice: Some("char_king_aldric.m19_thron_a")), (speaker: "Isolde Raventhorn", text: "Ich bin hier, Majestät. Ruht Euch aus.", voice: Some("hero_isolde.m19_thron_b")), (speaker: "König Aldric III.", text: "Mireille steht vor den Toren. Nimmt sie den Thron mit dem Schwert, glaubt jeder Herzog, er dürfe es auch. Valemark wird sich zerfleischen.", voice: Some("char_king_aldric.m19_thron_c")), (speaker: "Herzogin Mireille Corvane", text: "Öffnet die Tore, Wächterin! Ich bin nicht gekommen, einen Sterbenden zu töten. Ich bin gekommen, ein sterbendes Königreich zu retten!", voice: Some("char_mireille.m19_thron_d"))]), Decision((id: "throne", speaker: "Bruder Hal Venn", title: "Der Thron von Valemark", text: "Mireille oder die Linie des Königs, Isolde. Beides hat seinen Preis – und beides wird Menschen töten.", voice: Some("char_hal_venn.m19_thron_e"), options: [(flag: "throne_mireille", label: "Mireille Corvane stützen", detail: "Nordmarks Heer kämpft an Eurer Seite; die Getreuen Aldrens stellen sich Euch entgegen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Öffnet die Tore. Valemark braucht eine starke Hand mehr als eine saubere.", voice: Some("hero_isolde.m19_thron_a_a")), (speaker: "Herzogin Mireille Corvane", text: "Danke, Wächterin. Die Geschichte wird es Verrat oder Weisheit nennen. Sorgen wir dafür, dass es Weisheit wird.", voice: Some("char_mireille.m19_thron_a_b")), (speaker: "König Aldric III.", text: "So sei es … Haltet … die Feuer am Brennen …", voice: Some("char_king_aldric.m19_thron_a_c"))]), SpawnUnits(unit: "knight", owner: 0, area: "bund", count: 6, attack: false, tag: None), SpawnUnits(unit: "swordsman", owner: 0, area: "bund", count: 8, attack: false, tag: None), SpawnUnits(unit: "crossbowman", owner: 0, area: "bund", count: 6, attack: false, tag: None), SpawnUnits(unit: "knight", owner: 1, area: "rebellen", count: 4, attack: true, tag: None), SpawnUnits(unit: "halberdier", owner: 1, area: "rebellen_ost", count: 6, attack: true, tag: None)]), (flag: "throne_aldren", label: "Aldrens Linie verteidigen", detail: "Die Königsgarde kämpft für Euch; Mireilles Heer stellt sich Euch entgegen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Die Tore bleiben zu. Die Krone geht nach Gesetz über, nicht durch Belagerung. Besetzt die Mauern.", voice: Some("hero_isolde.m19_thron_b_a")), (speaker: "Herzogin Mireille Corvane", text: "Dann habt Ihr eine Leiche einem Land vorgezogen. Wir sehen uns auf dem Feld, Wächterin.", voice: Some("char_mireille.m19_thron_b_b")), (speaker: "König Aldric III.", text: "Euer Vater … wäre stolz. Es tut mir … leid, dass es so viel kostet.", voice: Some("char_king_aldric.m19_thron_b_c"))]), SpawnUnits(unit: "halberdier", owner: 0, area: "bund", count: 6, attack: false, tag: None), SpawnUnits(unit: "knight", owner: 0, area: "bund_ost", count: 4, attack: false, tag: None), SpawnUnits(unit: "crossbowman", owner: 0, area: "bund_ost", count: 6, attack: false, tag: None), SpawnUnits(unit: "knight", owner: 1, area: "rebellen", count: 6, attack: true, tag: None), SpawnUnits(unit: "swordsman", owner: 1, area: "rebellen_ost", count: 6, attack: true, tag: None), SpawnUnits(unit: "crossbowman", owner: 1, area: "rebellen_ost", count: 4, attack: true, tag: None)])])), AddObjective("obj_side"), AddObjective("obj_hero")], modes: []),
    (id: "schlacht", condition: Any([Flag("throne_mireille"), Flag("throne_aldren")]), actions: [CompleteObjective("obj_side"), AddObjective("obj_win"), AddObjective("obj_marshal"), Dialogue([(speaker: "Erzähler", text: "Zwei Heere an einem Fluss. Das Wasser war flach, die Furt breit, und auf beiden Ufern standen Menschen, die mit demselben Gebet in dieselbe Schlacht zogen.", voice: Some("narrator.m19_schlacht_a")), (speaker: "Isolde Raventhorn", text: "Haltet die Furt! Die Reiter an die Flanken, Armbrüste in die Mitte – und lasst sie kommen!", voice: Some("hero_isolde.m19_schlacht_b"))]), Chronicle("An der Furt von Kaldris wurde die Entscheidungsschlacht des Erbfolgekriegs geschlagen.")], modes: []),
    (id: "marschall", condition: TagDead("marshal"), actions: [CompleteObjective("obj_marshal"), Message(speaker: "Isolde Raventhorn", text: "Der Marschall ist gefallen! Jetzt drängt nach!", voice: None)], modes: []),
    (id: "sieg", condition: All([Any([Flag("throne_mireille"), Flag("throne_aldren")]), Any([All([AtTime(60.0), EnemyUnitsAtMost(4)]), TagDead("marshal")])]), actions: [CompleteObjective("obj_win"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Als der Rauch sich über der Furt lichtete, trug der Fluss seine Toten in die Ebene. Das Banner der Raventhorns wehte im Zentrum, und die Herzöge zählten ihre Schwüre noch einmal nach.", voice: Some("narrator.m19_sieg_a"))]), Chronicle("Die Furt von Kaldris fiel an die Wächterin."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel an der Furt von Kaldris.", voice: None), Defeat], modes: []),
  ],
