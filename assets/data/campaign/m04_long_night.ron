  ],
  starts: [
    (owner: 0, x: 40.0, y: 41.0),
    (owner: 1, x: 40.0, y: 4.0),
  ],
  briefing: "Brennhollow, Jahr 899 n.F. Zwei Jahre nach dem ersten Schrein ist Brennhollow gewachsen: Mauern, Kaserne, Gehöfte, hundert Stimmen am Marktplatz. Doch in dieser Nacht zieht das Hohle Tief alles zusammen, was es hat. Der König hat einen Gesandten geschickt, der im Morgengrauen eintreffen soll – wenn es einen Morgen gibt. Haltet Mauern und Bergfried bis zum ersten Licht. Von allen vier Seiten rollen die Wellen heran, und mit ihnen kommen Grabkolosse, die Mauern einreißen. Nutzt Eure Helden und Eure Schützen auf den Türmen.",
  author: "Ashen Crowns",
  year: Some(899),
  unit_cap: None,
  start_time: Some(0.72),
  free_economy: false,
  kind: "Überleben bis zum Morgengrauen",
  victory_text: "Das erste Licht traf die Zinnen von Brennhollow. Die Mauern standen, die Fahne wehte – und auf der Südstraße näherte sich ein Reiter in Schwarz.",
  defeat_text: "Die Mauern fielen, die Glocke verstummte. Brennhollow ging in der Langen Nacht unter.",
  intro_chronicle: "",
  chronicle_title: "Die Lange Nacht",
