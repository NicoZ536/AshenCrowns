  objectives: [
    (id: "obj_dawn", text: "Haltet Brennhollow bis zum Morgengrauen.", optional: false),
    (id: "obj_keep", text: "Der Bergfried darf nicht fallen.", optional: false),
    (id: "obj_brutes", text: "Zerschlagt die Grabkolosse, bevor sie die Mauer einreißen.", optional: true),
  ],
  triggers: [
    (id: "nacht", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Die Hohlen kamen nicht mehr in Wellen. In dieser Nacht kamen sie wie eine Flut, die einen Deich gefunden hat. Auf den Zinnen von Brennhollow zählten die Wächter ihre Fackeln und sagten nichts.", voice: Some("narrator.m04_nacht_a")), (speaker: "Bruder Hal Venn", text: "Der Gesandte des Königs soll bei Sonnenaufgang eintreffen, Isolde. Wenn er uns lebend findet, haben wir genug erreicht.", voice: Some("char_hal_venn.m04_nacht_b")), (speaker: "Isolde Raventhorn", text: "Dann sorgen wir dafür, dass er uns lebend findet. Bogenschützen auf die Türme, Schwertträger ans Tor!", voice: Some("hero_isolde.m04_nacht_c"))]), AddObjective("obj_dawn"), AddObjective("obj_keep"), AddObjective("obj_brutes"), Chronicle("In der Langen Nacht sammelte das Hohle Tief alles, was es besaß.")], modes: []),
    (id: "w1", condition: AtTime(40.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 10, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 3, attack: true, tag: None)], modes: []),
    (id: "w2", condition: AtTime(85.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "nord", count: 12, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "nord", count: 4, attack: true, tag: None)], modes: []),
    (id: "w3", condition: AtTime(135.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "ost", count: 10, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "ost", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "ost", count: 3, attack: true, tag: None)], modes: []),
    (id: "kolosse", condition: AtTime(190.0), actions: [Dialogue([(speaker: "Bruder Hal Venn", text: "Sie bringen die Kolosse! Haltet die Tore, Isolde – ich singe die Mauer fest, so lange meine Stimme trägt!", voice: Some("char_hal_venn.m04_mitte_a"))]), SpawnUnits(unit: "grave_brute", owner: 1, area: "sued", count: 2, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "sued", count: 10, attack: true, tag: None)], modes: []),
    (id: "w5", condition: AtTime(250.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 14, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "west", count: 2, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 5, attack: true, tag: None)], modes: []),
    (id: "w6", condition: AtTime(310.0), actions: [SpawnUnits(unit: "grave_brute", owner: 1, area: "nord", count: 2, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "nord", count: 12, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "nord", count: 4, attack: true, tag: None)], modes: []),
    (id: "w7", condition: AtTime(380.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "ost", count: 14, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "ost", count: 6, attack: true, tag: None), SpawnUnits(unit: "bat_swarm", owner: 1, area: "ost", count: 3, attack: true, tag: None)], modes: []),
    (id: "w8", condition: AtTime(450.0), actions: [SpawnUnits(unit: "grave_brute", owner: 1, area: "sued", count: 3, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "sued", count: 14, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "sued", count: 2, attack: true, tag: None)], modes: []),
    (id: "w9", condition: AtTime(510.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 12, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 6, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "west", count: 4, attack: true, tag: None)], modes: []),
    (id: "kolosse_tot", condition: All([AtTime(200.0), EnemyUnitsAtMost(0)]), actions: [CompleteObjective("obj_brutes")], modes: []),
    (id: "morgen", condition: AtTime(560.0), actions: [CompleteObjective("obj_dawn"), CompleteObjective("obj_keep"), Dialogue([(speaker: "Erzähler", text: "Der Himmel über der Aschmark wurde grau, dann fahl, dann golden an den Rändern. Die Letzten der Hohlen sanken in die Erde zurück, als hätten sie nur geträumt, lebendig zu sein.", voice: Some("narrator.m04_morgen_a")), (speaker: "Kassian Vale", text: "Eine Nacht, die man in Kaldris noch in Jahren erzählen wird – leider ohne Wahrheit. Ich bin Kassian Vale. Seine Majestät bittet Euch, Wächterin, um Euren Treueeid. Und bevor Ihr antwortet: Herzogin Mireille Corvane bietet Euch fünfhundert Speere und Korn für ein Jahr.", voice: Some("char_kassian.m04_morgen_b"))]), Decision((id: "oath", speaker: "Kassian Vale", title: "Treueeid oder Bündnis", text: "Zwei Hände strecken sich Euch entgegen, Wächterin. Die Krone fordert Euren Eid, Nordmark bietet Speere. Welche Hand Ihr heute nehmt – die andere hält morgen ein Messer.", voice: Some("char_kassian.m04_morgen_c"), options: [(flag: "oath_crown", label: "Der Krone den Treueeid schwören", detail: "Die Krone unterstützt Euch mit einer königlichen Garde; Nordmark wird kühl.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Mein Vater starb, als er Valemarks Grenze hielt. Ich werde sie auch halten. Für die Glutkrone, Majestät.", voice: Some("hero_isolde.m04_eid_a_a")), (speaker: "Kassian Vale", text: "Wie standhaft. Der König wird es zu schätzen wissen – und die Herzogin sich Euren Namen merken.", voice: Some("char_kassian.m04_eid_a_b"))])]), (flag: "oath_corvane", label: "Mireilles Bündnis annehmen", detail: "Nordmarks Speere stehen Euch bei – doch Mireille wird Gegenleistungen verlangen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Meine Leute können keine Eide essen. Richtet der Herzogin aus, dass ich ihre Speere annehme.", voice: Some("hero_isolde.m04_eid_b_a")), (speaker: "Kassian Vale", text: "Eine kluge Entscheidung – und eine sehr teure. Nordmark erinnert sich an Freunde, Wächterin. Und an Schuldner.", voice: Some("char_kassian.m04_eid_b_b"))])])]))], modes: []),
    (id: "sieg", condition: Any([Flag("oath_crown"), Flag("oath_corvane")]), actions: [Chronicle("Brennhollow überstand die Lange Nacht und erhielt den Besuch des Königs."), Victory], modes: []),
  ],
