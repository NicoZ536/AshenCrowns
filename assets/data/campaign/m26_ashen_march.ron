  triggers: [
    (id: "marsch", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Sie kamen im Gleichschritt. Zum ersten Mal seit dem Aschenfall hörte man die Hohlen nicht durch die Nacht schlurfen, sondern marschieren – und der Boden der Aschmark antwortete mit einem Beben.", voice: Some("narrator.m26_marsch_a")), (speaker: "Bruder Hal Venn", text: "Es ist die Legion, Isolde. Die Wappen Aureths auf jeder Brust. Ich habe sie als Junge in den Liedern gesehen – nicht im Fleisch.", voice: Some("char_hal_venn.m26_marsch_b"))]), Decision((id: "march", speaker: "Isolde Raventhorn", title: "Halten oder Evakuieren", text: "Dies ist keine Entscheidung, die ich allein treffen will. Aber sie steht mir zu. Halten wir Brennhollow – oder retten wir die, die in ihm wohnen?", voice: Some("hero_isolde.m26_marsch_c"), options: [(flag: "march_hold", label: "Brennhollow halten", detail: "Die Stadt kämpft bis zum Morgen; verliert sie, ist die Mission verloren.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Wir halten. Diese Mauern haben dreißig Jahre Feuer gesehen. Jeder Bürger auf die Wälle, jedes Kind in die Keller!", voice: Some("hero_isolde.m26_wahl_a_a")), (speaker: "Bruder Hal Venn", text: "Die Flamme steht mit Brennhollow. Sie hat es immer getan.", voice: Some("char_hal_venn.m26_wahl_a_b"))]), Grant((gold: 300.0, wood: 200.0, stone: 200.0, food: 0.0))]), (flag: "march_evacuate", label: "Die Bürger evakuieren", detail: "Brennhollow fällt, aber die Menschen überleben und folgen Euch nach Solmere.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Wir räumen die Stadt. Die Legion kann Steine erobern, aber keine Menschen. Das Osttor auf – alle zum Kaldris-Pass!", voice: Some("hero_isolde.m26_wahl_b_a")), (speaker: "Bruder Hal Venn", text: "Ich habe diese Mauern mit eigenen Händen gesegnet. Es ist eine gute Entscheidung. Es wird nur lange wehtun.", voice: Some("char_hal_venn.m26_wahl_b_b"))])])])), AddObjective("obj_choice"), AddObjective("obj_hero"), Chronicle("Die Aschenlegion marschierte auf Brennhollow.")], modes: []),
    (id: "hold", condition: Flag("march_hold"), actions: [CompleteObjective("obj_choice"), AddObjective("obj_hold")], modes: []),
    (id: "evac", condition: Flag("march_evacuate"), actions: [CompleteObjective("obj_choice"), AddObjective("obj_evac"), Dialogue([(speaker: "Isolde Raventhorn", text: "Haltet die Reihen, und lasst die Kinder zwischen den Wagen gehen! Die Soldaten decken den Rückzug – wer zurückbleibt, bleibt mit Ehre!", voice: Some("hero_isolde.m26_flucht_a"))])], modes: []),
    (id: "w1", condition: AtTime(60.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "nord", count: 8, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "nord", count: 4, attack: true, tag: None)], modes: []),
    (id: "w2", condition: AtTime(120.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "west", count: 8, attack: true, tag: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 8, attack: true, tag: None)], modes: []),
    (id: "w3", condition: AtTime(190.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "sued", count: 8, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "sued", count: 2, attack: true, tag: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "sued", count: 1, attack: true, tag: None)], modes: []),
    (id: "w4", condition: AtTime(260.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "nord", count: 10, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "nord", count: 6, attack: true, tag: None), SpawnUnits(unit: "ghoul", owner: 1, area: "nord", count: 4, attack: true, tag: None)], modes: []),
    (id: "w5", condition: AtTime(330.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "west", count: 10, attack: true, tag: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "west", count: 2, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "west", count: 2, attack: true, tag: None)], modes: []),
    (id: "w6", condition: AtTime(400.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "sued", count: 10, attack: true, tag: None), SpawnUnits(unit: "hollow_archer", owner: 1, area: "sued", count: 6, attack: true, tag: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "sued", count: 2, attack: true, tag: None)], modes: []),
    (id: "keep_lost", condition: All([Flag("march_hold"), TagDead("player_keep")]), actions: [Message(speaker: "Erzähler", text: "Der Bergfried fiel. Brennhollow war verloren.", voice: None), Defeat], modes: []),
    (id: "civ_lost", condition: All([Flag("march_evacuate"), AtTime(30.0), Not(UnitCount(unit: "worker", count: 9))]), actions: [Message(speaker: "Erzähler", text: "Zu wenige Bürger erreichten den Pass.", voice: None), Defeat], modes: []),
    (id: "sieg_hold", condition: All([Flag("march_hold"), AtTime(480.0)]), actions: [CompleteObjective("obj_hold"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Das Morgenlicht fand die Zinnen von Brennhollow zerschossen, aber nicht erstürmt. Die Legion zog sich zurück, dem Süden entgegen – ein Heer, das nicht müde wurde, aber wartete.", voice: Some("narrator.m26_morgen_a"))]), Chronicle("Brennhollow hielt gegen die Aschenlegion."), Victory], modes: []),
    (id: "sieg_evac", condition: All([Flag("march_evacuate"), UnitKindInArea(unit: "worker", area: "pass", count: 12)]), actions: [CompleteObjective("obj_evac"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Hinter ihnen brannte Brennhollow. Niemand sah sich um. Wer zurückblickte, hörte das Läuten der Kapelle – und erst später begriff man, dass sie von selbst läutete.", voice: Some("narrator.m26_pass_a"))]), Chronicle("Die Bürger von Brennhollow erreichten die Straße nach Kaldris."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel vor Brennhollow.", voice: None), Defeat], modes: []),
  ],
