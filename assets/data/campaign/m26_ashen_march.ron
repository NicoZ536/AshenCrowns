  starts: [
    (owner: 0, x: 46.0, y: 40.0),
    (owner: 1, x: 46.0, y: 4.0),
  ],
  briefing: "Brennhollow, Jahr 923 n.F. Aus der Siedlung ist eine Stadt geworden: Mauern, Märkte, zweitausend Bürger. Und nun kommt die Aschenlegion, in Reih und Glied, mit den Fahnen Aureths. Der Hohle König ist erwacht. Ihr habt zwei Möglichkeiten: Haltet Brennhollow bis zum Morgen – schwer, aber der Stadt Ehre – oder führt die Bürger durch das Osttor auf die Straße nach Kaldris, und überlasst die Stadt der Legion. Beides kostet etwas. Am Ende zählt, wer Euch folgt.",
  author: "Ashen Crowns",
  year: Some(923),
  unit_cap: None,
  start_time: Some(0.7),
  kind: "Halten oder Evakuieren",
  victory_text: "Das Morgenlicht fand Brennhollow noch aufrecht. Die Legion wich, aber ihr Marsch war nicht zu Ende.",
  defeat_text: "Brennhollow fiel in Asche, und die Legion zog weiter nach Süden.",
  intro_chronicle: "",
  chronicle_title: "Der Aschenmarsch",
