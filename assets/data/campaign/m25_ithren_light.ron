  objectives: [
    (id: "obj_shrine", text: "Erreicht den Schrein Ithrens unter dem Sonnenhof.", optional: false),
    (id: "obj_guard", text: "Bezwingt den Sonnenwächter des Schreins.", optional: false),
    (id: "obj_truth", text: "Entscheidet über Varkhans Tagebuch.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "ruinen", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Solmere war einst eine Stadt aus Licht gewesen, Terrassen aus weißem Stein bis an den Himmel. Nun waren es Rippen, in denen der Wind klagte – und zwischen den Rippen standen Männer mit Sonnen auf den Brustpanzern, die auf einen toten König warteten.", voice: Some("narrator.m25_ruinen_a")), (speaker: "Bruder Hal Venn", text: "Sei vorsichtig, Isolde. Die Sonnenhäretiker töten Fremde, aber sie töten sie mit Gebeten. Das macht es nicht besser.", voice: Some("char_hal_venn.m25_ruinen_b"))]), AddObjective("obj_shrine"), AddObjective("obj_guard"), AddObjective("obj_truth"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn drang in die Ruinen von Solmere vor.")], modes: []),
    (id: "wache", condition: TagDead("sun_guard"), actions: [CompleteObjective("obj_guard")], modes: []),
    (id: "schrein", condition: All([UnitsInArea(area: "schrein", count: 1), TagDead("sun_guard")]), actions: [CompleteObjective("obj_shrine"), Dialogue([(speaker: "Erzähler", text: "Unter den Resten des Sonnenhofs lag das Licht Ithrens, kaum größer als eine Kerzenflamme. Daneben, in einer Nische aus Gold, ein Buch, dessen Seiten nach Rauch und Rosenwasser rochen.", voice: Some("narrator.m25_tagebuch_a")), (speaker: "Bruder Hal Venn", text: "Varkhans Tagebuch. Er schreibt … von seiner Tochter. Sie starb an der Schwindsucht, und er wollte … er wollte nicht den Tod besiegen, Isolde. Er wollte sie.", voice: Some("char_hal_venn.m25_tagebuch_b")), (speaker: "Die Stimme aus dem Tief", text: "Ein Vater, der alles verbrannte, um ein Kind zu retten. So rührend. So nützlich.", voice: Some("char_deep_voice.m25_tagebuch_c"))]), Decision((id: "sun", speaker: "Bruder Hal Venn", title: "Das Tagebuch des Sonnenkönigs", text: "Es liegt bei dir, Isolde. Das Buch enthält die Wahrheit, und die Wahrheit hat Folgen.", voice: Some("char_hal_venn.m25_tagebuch_d"), options: [(flag: "sun_truth", label: "Die Wahrheit offenlegen", detail: "Die Häresie zerbricht; ihre Anhänger stehen später nicht mehr unter Waffen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Die Wahrheit gehört den Menschen. Lasst sie lesen, was Varkhan getan hat – und warum. Wer ihn dann noch erlösen will, soll es wissen.", voice: Some("hero_isolde.m25_urteil_a_a")), (speaker: "Bruder Hal Venn", text: "Das wird die Häresie spalten. Aber vielleicht ist das besser, als wenn sie an einer Lüge zerbricht.", voice: Some("char_hal_venn.m25_urteil_a_b"))])]), (flag: "sun_faith", label: "Den Glauben bewahren", detail: "Die Häretiker stehen den Toren Solmeres wohlgesonnen gegenüber.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Sie glauben an etwas, das sie am Leben hält. Ich nehme ihnen das nicht, bevor ich es ersetzen kann.", voice: Some("hero_isolde.m25_urteil_b_a")), (speaker: "Bruder Hal Venn", text: "Gnade und Feigheit sind manchmal Geschwister. Ich hoffe, du weißt, welche du gerade wählst.", voice: Some("char_hal_venn.m25_urteil_b_b"))])]), (flag: "sun_used", label: "Die Häretiker nutzen", detail: "Die Häretiker kämpfen später an Eurer Seite – bis die Wahrheit sie einholt.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Sie glauben, er werde zurückkehren. Gut. Sie sollen für ihn kämpfen – bis ich ihn selbst stelle.", voice: Some("hero_isolde.m25_urteil_c_a")), (speaker: "Die Stimme aus dem Tief", text: "Wie praktisch du bist, kleine Flamme. Wie ähnlich uns.", voice: Some("char_deep_voice.m25_urteil_c_b"))])])]))], modes: []),
    (id: "sieg", condition: Any([Flag("sun_truth"), Flag("sun_faith"), Flag("sun_used")]), actions: [CompleteObjective("obj_truth"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Das Licht Ithrens erlosch nicht. Es wartete, mit der Geduld der Götter, auf jemanden, der bereit war, es zu tragen.", voice: Some("narrator.m25_sieg_a"))]), Chronicle("Isolde Raventhorn las das Tagebuch des Sonnenkönigs."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel in den Ruinen von Solmere.", voice: None), Defeat], modes: []),
  ],
