    (id: "knight", owner: 1, x: 36.0, y: 10.0, count: 1, tag: Some("wache3"), guard: true, camp: None),
    (id: "swordsman", owner: 1, x: 33.0, y: 12.0, count: 2, tag: None, guard: true, camp: None),
    (id: "archer", owner: 1, x: 39.5, y: 12.0, count: 2, tag: None, guard: true, camp: None),
    (id: "crossbowman", owner: 1, x: 36.0, y: 14.5, count: 1, tag: None, guard: true, camp: None),
  ],
  objectives: [
    (id: "obj_e1", text: "Untersucht den Weinkeller.", optional: false),
    (id: "obj_e2", text: "Untersucht die Kapelle der Ewigen Flamme.", optional: false),
    (id: "obj_e3", text: "Findet das Siegel in der Krypta unter dem Dom.", optional: true),
    (id: "obj_dom", text: "Tretet vor den Hof im Flammendom.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "nacht", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Der König starb im Winter, und die Glocken von Kaldris waren die Einzigen, die es laut sagten. Im Flammendom brannten die Kerzen weiter, als hätte niemand ihnen Bescheid gegeben.", voice: Some("narrator.m17_nacht_a")), (speaker: "Isolde Raventhorn", text: "Drei Spuren, ein Mörder. Der Wein, die Flamme, die Gruft. Wir gehen leise vor – wer hier Zeugen hat, hat auch Feinde.", voice: Some("hero_isolde.m17_nacht_b"))]), AddObjective("obj_e1"), AddObjective("obj_e2"), AddObjective("obj_e3"), AddObjective("obj_dom"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn untersuchte den Tod König Aldrics III.")], modes: []),
    (id: "keller", condition: UnitsInArea(area: "keller", count: 1), actions: [SetFlag("evid_1"), CompleteObjective("obj_e1"), Dialogue([(speaker: "Isolde Raventhorn", text: "Schierling im Wein. Frisch angesetzt, und nur ein einziger Krug. Wer das getan hat, kannte seinen Geschmack – und wusste, dass er Gold trinkt, kein Wasser.", voice: Some("hero_isolde.m17_keller_a"))])], modes: []),
    (id: "kapelle", condition: UnitsInArea(area: "kapelle", count: 1), actions: [SetFlag("evid_2"), CompleteObjective("obj_e2"), Dialogue([(speaker: "Isolde Raventhorn", text: "Ein Brief unter dem Altarstein, mit dem Siegel Nordmarks. Aber die Tinte ist zu frisch, das Wachs zu sauber. Das hat jemand für mich hingelegt.", voice: Some("hero_isolde.m17_kapelle_a"))])], modes: []),
    (id: "krypta", condition: UnitsInArea(area: "krypta", count: 1), actions: [SetFlag("evid_3"), CompleteObjective("obj_e3"), Dialogue([(speaker: "Isolde Raventhorn", text: "Das Siegel der Sonnenhäresie, in den Stein der Gruft geritzt. Jemand hat dem König Gift gegeben – und die Hohlen haben es gewusst, bevor er starb.", voice: Some("hero_isolde.m17_krypta_a"))])], modes: []),
    (id: "dom", condition: All([UnitsInArea(area: "dom", count: 1), ObjectiveCompleted("obj_e1"), ObjectiveCompleted("obj_e2")]), actions: [CompleteObjective("obj_dom"), Dialogue([(speaker: "Erzähler", text: "Im Flammendom waren sie alle versammelt: die Herzöge, die Flammenwahrer, die Räte. Und in der Mitte der Sarg des Königs, leer – der Leichnam lag noch im Nebenraum, damit niemand ihn küsste.", voice: Some("narrator.m17_hof_a")), (speaker: "Herzogin Mireille Corvane", text: "Wächterin. Man sagt, Ihr wisst, wer es war. Sagt es – oder lasst uns dem Mörder zuprosten, so lange er bei uns sitzt.", voice: Some("char_mireille.m17_hof_b"))]), Decision((id: "blame", speaker: "Bruder Hal Venn", title: "Wem gilt die Anklage?", text: "Du darfst nur einen Namen nennen, Isolde. Es ist die Aufgabe einer Wächterin, zu entscheiden – und den Preis zu tragen.", voice: Some("char_hal_venn.m17_hof_c"), options: [(flag: "blame_kassian", label: "Kassian Vale beschuldigen", detail: "Kassian wird zum Feind; die Hohlen lachen im Verborgenen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Kassian Vale hat es gewusst. Er hat gewarnt, wo er hätte handeln müssen. Sucht ihn – und fragt ihn nach seiner Rolle.", voice: Some("hero_isolde.m17_urteil_a_a")), (speaker: "Herzogin Mireille Corvane", text: "Ein Spion, der zu viel wusste. Wie vorhersehbar – und wie bequem.", voice: Some("char_mireille.m17_urteil_a_b"))])]), (flag: "blame_mireille", label: "Mireille Corvane beschuldigen", detail: "Der Bürgerkrieg beginnt; Nordmark wird zum Gegner.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Der Brief weist nach Nordmark. Herzogin Mireille, erklärt Euch.", voice: Some("hero_isolde.m17_urteil_b_a")), (speaker: "Herzogin Mireille Corvane", text: "Ihr beschuldigt eine Frau, die fünfhundert Speere in Euren Dienst gestellt hat. Ihr werdet es bereuen.", voice: Some("char_mireille.m17_urteil_b_b"))])]), (flag: "blame_heretics", label: "Die Sonnenhäretiker beschuldigen", detail: "Die Stadt wird gesäubert – die Häresie geht in den Untergrund.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Es waren die Sonnenhäretiker. Ihre Zeichen sind im Stein der Gruft. Kaldris hat Verräter in den eigenen Mauern.", voice: Some("hero_isolde.m17_urteil_c_a")), (speaker: "Herzogin Mireille Corvane", text: "Dann reinigt die Stadt. Aber lasst die Herzöge auch ruhig schlafen.", voice: Some("char_mireille.m17_urteil_c_b"))])]), (flag: "blame_truth", label: "Die ganze Wahrheit sagen", detail: "Nur mit allen drei Beweisen: Der Hof muss Euch folgen, und die Häretiker haben nichts mehr zu verbergen.", requires: ["evid_3"], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Ich kenne die ganze Wahrheit: Gift im Wein, ein falscher Brief aus Nordmark, das Siegel der Häresie – und einer, der sie alle vermittelte. Seht auf die, die von Verwirrung leben.", voice: Some("hero_isolde.m17_urteil_d_a")), (speaker: "Herzogin Mireille Corvane", text: "Ihr habt mehr Mut, als ich Euch zutraute. Und mehr Beweise, als mir lieb ist.", voice: Some("char_mireille.m17_urteil_d_b"))])])]))], modes: []),
    (id: "sieg", condition: Any([Flag("blame_kassian"), Flag("blame_mireille"), Flag("blame_heretics"), Flag("blame_truth")]), actions: [CompleteObjective("obj_hero"), Chronicle("Isolde Raventhorn sprach den Namen des Schuldigen aus."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel in den Gassen von Kaldris.", voice: None), Defeat], modes: []),
  ],
