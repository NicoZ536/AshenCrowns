  areas: [
    (id: "keller", name: "Der Weinkeller", x: 5, y: 53, w: 12, h: 10),
    (id: "kapelle", name: "Die Kapelle der Ewigen Flamme", x: 53, y: 51, w: 12, h: 10),
    (id: "krypta", name: "Die Krypta unter dem Dom", x: 29, y: 6, w: 14, h: 10),
    (id: "dom", name: "Der Flammendom", x: 28, y: 28, w: 16, h: 16),
  ],
  starts: [
    (owner: 0, x: 36.0, y: 66.0),
  ],
  briefing: "Kaldris, Jahr 916 n.F. König Aldric III. wurde in der Nacht vergiftet. Der Hof schweigt, die Herzöge ziehen ihre Banner zusammen, und Kassian Vale ist verschwunden. Ihr habt keine Armee, nur Isolde Raventhorn und eine kleine Eskorte – und drei Spuren: den Weinkeller, die Kapelle der Ewigen Flamme und die Krypta unter dem Dom. Je mehr Beweise Ihr findet, desto mehr Möglichkeiten habt Ihr: Wer die Wahrheit kennt, kann sie aussprechen. Wer sie nicht kennt, kann nur wählen, wem er glaubt.",
  author: "Ashen Crowns",
  year: Some(916),
  unit_cap: None,
  start_time: Some(0.88),
  kind: "Ermittlung (Heldenmission)",
