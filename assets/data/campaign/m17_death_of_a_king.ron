(
  id: "m17_death_of_a_king",
  name: "Tod eines Königs",
  description: "König Aldric III. ist tot – vergiftet, sagt der Hof. Sucht im Flammendom von Kaldris die Spuren und entscheidet, wen Ihr beschuldigt.",
  map_seed: 91617,
  start_resources: (
