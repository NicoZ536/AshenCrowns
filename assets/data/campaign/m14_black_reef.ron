  objectives: [
    (id: "obj_dam", text: "Überquert den Riffdamm.", optional: false),
    (id: "obj_boss", text: "Bezwingt Isarre Mol, Herrin des Schwarzen Riffs.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "kai", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Ophira Saelith-Varo", text: "Willkommen am Kai, Wächterin. Vorsicht mit den Tauen, sie kosten mehr als Eure Stiefel.", voice: Some("char_ophira.m14_tintenfass_a")), (speaker: "Isolde Raventhorn", text: "Alles hier kostet mehr als meine Stiefel. Das macht mir Sorgen.", voice: Some("hero_isolde.m14_tintenfass_b")), (speaker: "Ophira Saelith-Varo", text: "Vierzig Schiffe, dreitausend Söldner und das Riff in neun Tagen statt in neunzig. Der Preis ist ein Anteil an jedem Splitter Aschglas, den Ihr aus den Ruinen holt.", voice: Some("char_ophira.m14_tintenfass_c")), (speaker: "Kassian Vale", text: "Lest das Kleingedruckte, Wächterin. In Saelith bewahrt man im Kleingedruckten die Messer auf.", voice: Some("char_kassian.m14_tintenfass_d"))]), Decision((id: "fleet", speaker: "Ophira Saelith-Varo", title: "Ophiras Vertrag", text: "Die Flut wartet auf niemanden, Wächterin. Unterschreibt oder lauft.", voice: Some("char_ophira.m14_tintenfass_e"), options: [(flag: "fleet_pact", label: "Die Flotte annehmen", detail: "Saelith-Söldner und Katapulte verstärken Euch – und Ihr schuldet Ophira Aschglas.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Gebt mir die Feder. Jeder Marschtag ist ein weiteres verlorenes Dorf.", voice: Some("hero_isolde.m14_flotte_a_a")), (speaker: "Ophira Saelith-Varo", text: "Großartig. Die Flut kommt immer zurück, um zu holen, was ihr geschuldet wird, Wächterin. Immer.", voice: Some("char_ophira.m14_flotte_a_b"))]), SpawnUnits(unit: "crossbowman", owner: 0, area: "kai", count: 8, attack: false, tag: None), SpawnUnits(unit: "halberdier", owner: 0, area: "kai", count: 4, attack: false, tag: None), SpawnUnits(unit: "catapult", owner: 0, area: "kai", count: 2, attack: false, tag: None)]), (flag: "fleet_none", label: "Ohne Flotte marschieren", detail: "Keine Schuld, aber weniger Truppen.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Wir laufen. Ich schulde lieber meinen Blasen etwas als Euch.", voice: Some("hero_isolde.m14_flotte_b_a")), (speaker: "Ophira Saelith-Varo", text: "Stolz. Das Teuerste, was ein Herrscher kaufen kann. Gute Winde, Wächterin.", voice: Some("char_ophira.m14_flotte_b_b"))])])])), Chronicle("Ophira Saelith-Varo bot Isolde Raventhorn die Flotte des Saelith-Paktes an.")], modes: []),
    (id: "start", condition: Any([Flag("fleet_pact"), Flag("fleet_none")]), actions: [AddObjective("obj_dam"), AddObjective("obj_boss"), AddObjective("obj_hero"), Chronicle("Der Marsch zum Schwarzen Riff begann.")], modes: []),
    (id: "damm", condition: UnitsInArea(area: "damm", count: 3), actions: [CompleteObjective("obj_dam")], modes: []),
    (id: "boss_begegnung", condition: UnitsInArea(area: "insel", count: 1), actions: [Dialogue([(speaker: "Isarre Mol", text: "Ihr kommt auf trockenen Füßen zu meiner Tür. Wie rührend. Das Meer hat mir jedes meiner Kinder zurückgegeben – ich bin nur gekommen, es zu tränken.", voice: Some("boss_reef_mistress.m14_isarre_a")), (speaker: "Isolde Raventhorn", text: "Dann bin ich hier, um dich zu erlösen. Eine Flut kann man dämmen.", voice: Some("hero_isolde.m14_isarre_b"))])], modes: []),
    (id: "sieg", condition: TagDead("boss"), actions: [CompleteObjective("obj_boss"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Das Wasser zog sich zurück, als hätte es nie anderes vorgehabt. Auf der Riffinsel blieben Muscheln, Knochen und eine Perle von der Größe einer Faust, die später in Brennhollow in eine Rüstung eingelegt wurde.", voice: Some("narrator.m14_sieg_a"))]), Chronicle("Isarre Mol, Herrin des Schwarzen Riffs, fiel."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn versank im Schwarzen Riff.", voice: None), Defeat], modes: []),
  ],
