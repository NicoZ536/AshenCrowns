  ],
  briefing: "Saelith-Küste, Jahr 912 n.F. Das Schwarze Riff war einmal ein Gezeitenheiligtum. Dann kam Isarre Mol, Priesterin des Hauses der Gezeiten, die dem Hohlen Tief die Flut verpfändete: Seither laufen die Wellen bergauf, und die Ertrunkenen steigen nachts an Land. Ophira Saelith-Varo bietet Isolde Raventhorn Schiffe, Söldner und Katapulte – gegen einen Anteil am Aschglas der Aurethküste. Wer ablehnt, marschiert allein. Das Riff liegt auf einer Insel; ein Damm aus Furt und Stein führt bei Ebbe hinüber. Isarre beschwört Fluten, entzieht Leben und ruft Ertrunkene.",
  author: "Ashen Crowns",
  year: Some(912),
  unit_cap: None,
  start_time: Some(0.62),
  kind: "Bossjagd an der Küste",
  victory_text: "Isarre Mol sank mit dem Rest ihrer Flut. Über dem Schwarzen Riff stieg das Meer langsam, aber freiwillig wieder an die Küste.",
  defeat_text: "Das Schwarze Riff behielt seine Herrin. Die Flut stieg über die Strände, und die Küste verstummte.",
  intro_chronicle: "",
  chronicle_title: "Das Schwarze Riff",
  variants: [
    (requires: ["rift_harvested"], forbids: [], note: "Die Hohlung hat sich verbreitet: Das Riff wird von zusätzlichen Ertrunkenen und Aschhexen bewacht.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "ghoul", owner: 1, x: 56.0, y: 26.0, count: 4, tag: None, guard: true, camp: None), (id: "ash_witch", owner: 1, x: 64.0, y: 24.0, count: 2, tag: None, guard: true, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
