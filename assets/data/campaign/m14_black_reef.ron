    (requires: ["fleet_pact"], forbids: [], note: "Der Vertrag liegt: Ophiras Schiffe bringen den Nachschub, aber die Kapitäne verlangen schon den ersten Anteil. Ihre Schiffsmannschaften verstärken das Ufer.", grant: (gold: 0.0, wood: 0.0, stone: 0.0, food: 0.0), goods: [], remove_tags: [], placements: [(id: "halberdier", owner: 0, x: 3.5, y: 47.0, count: 2, tag: None, guard: false, camp: None)], objectives: [], areas: [], triggers: [], wave_mult: 0.0),
