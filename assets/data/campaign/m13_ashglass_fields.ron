  triggers: [
    (id: "wueste", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Es war ein Land, das einmal Reich geheißen hatte. Nun lag es als flache Asche bis zum Horizont, und in der Asche funkelten Splitter – Aschglas, wo der Schleier dünn war, und Wachfeuer, wo die Legion stand.", voice: Some("narrator.m13_wueste_a")), (speaker: "Isolde Raventhorn", text: "Schwarze Rüstungen, Glut in den Fugen, und das Wappen Aureths auf der Brust. Das sind keine Wiedergänger, das ist eine Armee. Zeigt ihnen Stahl – und Feuer.", voice: Some("hero_isolde.m13_wueste_b"))]), AddObjective("obj_op1"), AddObjective("obj_op2"), AddObjective("obj_op3"), AddObjective("obj_hero"), SetWeather(Ashfall), Chronicle("Die Aschmark marschierte gegen die Außenposten der Aschenlegion.")], modes: []),
