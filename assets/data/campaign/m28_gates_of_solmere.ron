  objectives: [
    (id: "obj_gate", text: "Brecht das Haupttor von Solmere.", optional: false),
    (id: "obj_keep", text: "Erobert den Torturm von Solmere.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "lager", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Hinter dem Horizont wuchsen die Mauern Solmeres: schwarz, hoch, in den Fugen glimmend. Zum ersten Mal seit tausend Jahren sahen lebende Menschen die Hauptstadt Aureths aus der Nähe – und zählten die Zinnen, ohne sie zu Ende zu zählen.", voice: Some("narrator.m28_lager_a")), (speaker: "Isolde Raventhorn", text: "Rammen ans Tor, Katapulte auf die Zinnen. Und niemand betritt Solmere, ehe das Tor offen ist – ich will keinen Mann vor die Hexen schicken, der noch eine Mauer überwinden muss.", voice: Some("hero_isolde.m28_lager_b"))]), AddObjective("obj_gate"), AddObjective("obj_keep"), AddObjective("obj_hero"), Chronicle("Der Bund der Letzten Flamme lagerte vor den Mauern Solmeres.")], modes: []),
    (id: "torvald", condition: All([Flag("torvald_blood"), AtTime(8.0)]), actions: [Dialogue([(speaker: "Torvald Eisenhand", text: "Meine Ahnen sehen zu, Isolde. Sie haben nie eine Mauer gesehen, vor der Eisenhand zögerte. Wir gehen zuerst – du brichst das Tor.", voice: Some("char_torvald.m28_torvald_a"))])], modes: []),
    (id: "sylaen", condition: All([Flag("rootmother_pact"), AtTime(14.0)]), actions: [Dialogue([(speaker: "Sylaen der Veyl", text: "Der Wald hat mich nicht verlassen, Wächterin. Meine Pfeile fliegen mit dem Wind – und der Wind kennt Solmere.", voice: Some("char_sylaen.m28_sylaen_a"))])], modes: []),
    (id: "ophira", condition: All([Flag("fleet_pact"), AtTime(20.0)]), actions: [Dialogue([(speaker: "Ophira Saelith-Varo", text: "Meine Schiffe liegen im Hafen, meine Söldner stehen bei Euch. Vergesst nicht, dass jeder Schuss in diesen Mauern ein Eintrag in meinem Buch ist.", voice: Some("char_ophira.m28_ophira_a"))])], modes: []),
    (id: "haeretiker", condition: All([Any([Flag("sun_truth"), Flag("sun_faith")]), AtTime(26.0)]), actions: [Dialogue([(speaker: "Erzähler", text: "Auf den Mauern Solmeres standen Männer mit Sonnen auf der Brust. Sie sahen die Banner des Bundes, hörten, was Isolde Raventhorn gelesen hatte, und senkten die Waffen. Man weiß nicht, ob aus Scham oder aus Hoffnung.", voice: Some("narrator.m28_haeretiker_a"))])], modes: []),
    (id: "tor", condition: TagDamaged("gate_keep"), actions: [CompleteObjective("obj_gate"), Dialogue([(speaker: "Isolde Raventhorn", text: "Das Tor ist gebrochen! Schildträger voran, die Priester folgen den Schilden – und lasst keinen zurück!", voice: Some("hero_isolde.m28_tor_a"))])], modes: []),
    (id: "sieg", condition: TagDead("gate_keep"), actions: [CompleteObjective("obj_keep"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Bruder Hal Venn", text: "Das war das Tor. Hinter ihm liegt der Thron. Ich muss dir etwas sagen, Isolde, bevor wir hineingehen: Danke. Für alles, was du getan hast – auch für das, was dich gekostet hat.", voice: Some("char_hal_venn.m28_sieg_a"))]), Chronicle("Die Tore von Solmere fielen."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel vor den Toren von Solmere.", voice: None), Defeat], modes: []),
  ],
  defeat_tag: "",
  enemy_base_tag: "",
  map: Some((
    width: 112,
