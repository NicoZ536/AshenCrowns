  objectives: [
    (id: "obj_courts", text: "Kämpft Euch durch den Mauerhof, den Sonnenhof und den Hof des Schleiers.", optional: false),
    (id: "obj_king", text: "Stellt Varkhan Aurelith, den Hohlen König, im Thronsaal.", optional: false),
    (id: "obj_choice", text: "Trefft die letzte Wahl.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "tor", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Hinter dem Tor lag, was von Aureth übrig war: vier Höfe, einer hinter dem anderen, wie Kammern eines Herzens. Und am Ende der Höfe der Thron, auf dem seit tausend Jahren jemand saß, der nicht schlief und nicht starb.", voice: Some("narrator.m29_tor_a")), (speaker: "Bruder Hal Venn", text: "Gleich ist es so weit, Isolde. Wenn du Zweifel hast – jetzt wäre der Moment, sie auszusprechen.", voice: Some("char_hal_venn.m29_tor_b")), (speaker: "Isolde Raventhorn", text: "Zweifel habe ich seit Brennhollow. Aber sie halten mich nicht mehr auf. Vorwärts, für die Mark.", voice: Some("hero_isolde.m29_tor_c"))]), AddObjective("obj_courts"), AddObjective("obj_king"), AddObjective("obj_choice"), AddObjective("obj_hero"), Chronicle("Der Bund der Letzten Flamme betrat Solmere.")], modes: []),
    (id: "schleier", condition: UnitsInArea(area: "schleier", count: 1), actions: [Dialogue([(speaker: "Erzähler", text: "Der dritte Hof war der Hof des Schleiers. Die Luft zitterte, als wäre sie nur gemalt, und über den Mauern hing ein Riss, durch den man die Nacht sah – eine, die nicht die eigene war.", voice: Some("narrator.m29_hoefe_a"))]), SetWeather(Storm)], modes: []),
    (id: "thron", condition: UnitsInArea(area: "thronsaal", count: 1), actions: [CompleteObjective("obj_courts"), Dialogue([(speaker: "Der Hohle König", text: "Ich war die Sonne von Aureth. Könige knieten vor meinem Schatten. Und nun betritt eine Grenzwächterin meinen Thronsaal.", voice: Some("boss_hollow_king.m29_thron_a")), (speaker: "Isolde Raventhorn", text: "Dein Schatten hat eine halbe Welt getötet, Varkhan. Ich bin hier, um ihn zurückzuschicken.", voice: Some("hero_isolde.m29_thron_b")), (speaker: "Der Hohle König", text: "Ich wollte den Tod beenden. Für alle. Verstehst du? Keine Gräber mehr. Keine trauernden Mütter. Es hat mir geantwortet … und es hat gelogen.", voice: Some("boss_hollow_king.m29_thron_c")), (speaker: "Die Stimme aus dem Tief", text: "Ich lüge nie. Ich versprach ihm, dass niemand sterben würde. Und in Solmere ist niemand mehr gestorben.", voice: Some("char_deep_voice.m29_thron_d"))])], modes: []),
    (id: "wahl", condition: TagHealthBelow(tag: "boss", percent: 50.0), actions: [Dialogue([(speaker: "Bruder Hal Venn", text: "Isolde, der Schleier ist offen hinter dem Thron. Was immer du tun willst, tu es jetzt.", voice: Some("char_hal_venn.m29_schleier_a")), (speaker: "Der Hohle König", text: "Nimm meine Krone, Wächterin. Befehlige die Toten, und kein Dorf wird je wieder brennen. Oder tritt durch den Schleier und schließe ihn hinter dir. So oder so … jemand muss die Asche tragen.", voice: Some("boss_hollow_king.m29_schleier_b")), (speaker: "Die Stimme aus dem Tief", text: "Wähle, kleine Flamme. Ich bin so oder so da.", voice: Some("char_deep_voice.m29_schleier_c"))]), Decision((id: "final", speaker: "Der Hohle König", title: "Die letzte Wahl", text: "Wähle, Wächterin. Es gibt keinen vierten Weg – außer denen, die du dir durch deine Wege verdient hast.", voice: Some("boss_hollow_king.m29_schleier_d"), options: [(flag: "final_seal", label: "Den Schleier von innen versiegeln", detail: "Isolde bleibt hinter dem Schleier zurück; die Welt ist sicher.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Hal. Halt die Feuer für mich am Brennen. Jemand muss die Tür halten.", voice: Some("hero_isolde.m29_ende_a_a")), (speaker: "Bruder Hal Venn", text: "Nein … Isolde … die Flamme behüte dich, Kind. Die Flamme behüte dich.", voice: Some("char_hal_venn.m29_ende_a_b")), (speaker: "Die Stimme aus dem Tief", text: "Tapfer. Kurz. Und nun … mein. Willkommen daheim.", voice: Some("char_deep_voice.m29_ende_a_c"))])]), (flag: "final_crown", label: "Die Hohle Krone nehmen", detail: "Die Toten gehorchen, aber die Stimme aus dem Tief bleibt.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Gib mir die Krone. Wenn die Toten marschieren müssen, dann für die Lebenden.", voice: Some("hero_isolde.m29_ende_b_a")), (speaker: "Der Hohle König", text: "Genau das habe ich auch gesagt.", voice: Some("boss_hollow_king.m29_ende_b_b")), (speaker: "Bruder Hal Venn", text: "Isolde … deine Augen. Die Flamme vergebe uns beiden.", voice: Some("char_hal_venn.m29_ende_b_c"))])]), (flag: "final_redeem", label: "Varkhan erlösen", detail: "Nur möglich, wenn Nel in Brennhollow aufgenommen wurde und die Wahrheit über die Sonnenhäresie bekannt ist.", requires: ["nel_sheltered", "sun_truth"], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Varkhan. Deine Tochter hieß Sereth. Sie hat dir nie gesagt, dass sie dir verzeiht, weil sie nie dachte, dass du es brauchst. Sie tut es.", voice: Some("hero_isolde.m29_ende_c_a")), (speaker: "Der Hohle König", text: "Sereth … Sereth. Ich habe den Namen so lange nicht gehört. Wer – wer hat ihn dir gesagt?", voice: Some("boss_hollow_king.m29_ende_c_b")), (speaker: "Nel", text: "Sie hat ihn mir gesagt. Im Schlaf. Sie wartet auf dich.", voice: Some("char_nel.m29_ende_c_c"))])]), (flag: "final_destroy", label: "Das Tiefe verbrennen", detail: "Nur möglich, wenn der Kern zerschlagen und der Riss von Marrowfen versiegelt wurde.", requires: ["core_smashed", "rift_sealed"], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Es gibt kein Tor, das ich schließen muss, und keinen Thron, den ich besteigen will. Es gibt nur Feuer – und das ist alles, was ich je gut konnte.", voice: Some("hero_isolde.m29_ende_d_a")), (speaker: "Die Stimme aus dem Tief", text: "Du verbrennst dich selbst, kleine Flamme. Schade. Ich hätte dich so gern behalten.", voice: Some("char_deep_voice.m29_ende_d_b"))])])]))], modes: []),
    (id: "verstaerkung", condition: TagHealthBelow(tag: "boss", percent: 75.0), actions: [SpawnUnits(unit: "ashen_legionnaire", owner: 1, area: "thronsaal", count: 4, attack: true, tag: None), SpawnUnits(unit: "ash_witch", owner: 1, area: "thronsaal", count: 1, attack: true, tag: None)], modes: []),
    (id: "sieg", condition: All([TagDead("boss"), Any([Flag("final_seal"), Flag("final_crown"), Flag("final_redeem"), Flag("final_destroy")])]), actions: [CompleteObjective("obj_king"), CompleteObjective("obj_choice"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Der Hohle König war gefallen. Die Glocken von Solmere läuteten ein letztes Mal, und danach hörte man in der ganzen Welt nur noch den Wind.", voice: Some("narrator.m29_sieg_a"))]), Chronicle("Varkhan Aurelith, der Hohle König, fiel in Solmere."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel im Thronsaal von Solmere.", voice: None), Defeat], modes: []),
  ],
