  starts: [
    (owner: 0, x: 48.0, y: 84.0),
    (owner: 1, x: 48.0, y: 14.0),
  ],
  briefing: "Solmere, Jahr 923 n.F. Das letzte Tor ist gefallen. Vor Euch liegen vier Höfe: der Mauerhof, der Sonnenhof, der Hof des Schleiers und der Thronsaal, in dem Varkhan Aurelith sitzt – der Hohle König, Herr der Legion, Schlüssel und Gefangener des Tiefs. Mit Euch ziehen Isolde, Hal Venn und alle, die der Bund gewinnen konnte. Wenn der König fällt, bis zur Hälfte seiner Kraft, öffnet der Schleier hinter dem Thron seinen Mund, und die Stimme aus dem Tief bietet Euch an, was sie immer anbietet. Wählt: versiegeln, krönen, erlösen oder verbrennen – wenn die Wege, die Ihr gegangen seid, es erlauben.",
  author: "Ashen Crowns",
  year: Some(923),
  unit_cap: None,
  start_time: Some(0.97),
  free_economy: true,
  kind: "Endschlacht",
  victory_text: "Der Hohle König fiel, und mit ihm schwiegen die Glocken Solmeres. Was auch immer von der Welt blieb: Es blieb, weil jemand die Wahl getroffen hatte.",
  defeat_text: "Der Thronsaal von Solmere blieb in den Händen der Toten. Das Hohle Tief sprach – und die Welt hörte zu.",
  intro_chronicle: "",
  chronicle_title: "Der Hohle Thron",
