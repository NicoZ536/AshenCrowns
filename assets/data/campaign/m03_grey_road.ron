(
  id: "m03_grey_road",
  name: "Die Graue Straße",
  description: "Die alte Handelsstraße nach Valemark ist in der Hand von Raubrittern. Brecht die drei Straßenposten – und entscheidet über Ser Wendel den Grauen.",
  map_seed: 89803,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 100.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
    interval_day: 150.0,
    interval_night: 95.0,
    base_budget: 3.0,
    budget_per_wave: 1.7,
    night_mult: 1.5,
  ),
  placements: [
    (id: "hero_isolde", owner: 0, x: 46.0, y: 88.5, count: 0, tag: Some("hero"), guard: false, camp: None),
    (id: "swordsman", owner: 0, x: 44.0, y: 87.0, count: 3, tag: None, guard: false, camp: None),
    (id: "spearman", owner: 0, x: 48.0, y: 87.5, count: 2, tag: None, guard: false, camp: None),
    (id: "archer", owner: 0, x: 46.0, y: 90.5, count: 4, tag: None, guard: false, camp: None),
    (id: "swordsman", owner: 1, x: 49.5, y: 64.5, count: 1, tag: Some("post1"), guard: true, camp: None),
    (id: "swordsman", owner: 1, x: 47.0, y: 66.0, count: 3, tag: None, guard: true, camp: None),
    (id: "archer", owner: 1, x: 51.0, y: 68.0, count: 3, tag: None, guard: true, camp: None),
    (id: "spearman", owner: 1, x: 60.5, y: 45.5, count: 1, tag: Some("post2"), guard: true, camp: None),
    (id: "spearman", owner: 1, x: 62.5, y: 47.0, count: 3, tag: None, guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 58.0, y: 49.5, count: 3, tag: None, guard: true, camp: None),
    (id: "archer", owner: 1, x: 64.0, y: 44.0, count: 2, tag: None, guard: true, camp: None),
    (id: "knight", owner: 1, x: 49.5, y: 14.5, count: 1, tag: Some("wendel"), guard: true, camp: None),
    (id: "swordsman", owner: 1, x: 46.0, y: 16.5, count: 4, tag: Some("wendel_men"), guard: true, camp: None),
    (id: "archer", owner: 1, x: 52.5, y: 17.5, count: 3, tag: Some("wendel_men"), guard: true, camp: None),
  ],
  objectives: [
    (id: "obj_post1", text: "Räumt den ersten Straßenposten an der Furt.", optional: false),
    (id: "obj_post2", text: "Räumt den zweiten Posten in der Gehöftruine.", optional: false),
    (id: "obj_wendel", text: "Stellt Ser Wendel den Grauen im Norden.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "aufbruch", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Die Graue Straße führte einmal von Brennhollow bis zu den Salzmärkten Valemarks. Nun führte sie vor allem zu Gräbern am Straßenrand – und an ihrem Ende saß ein Ritter, der mit seinen Opfern Buch führte.", voice: Some("narrator.m03_aufbruch_a")), (speaker: "Isolde Raventhorn", text: "Neun Leute für eine Straße von dreißig Meilen. Das ist keine Armee, das ist ein Spaziergang mit Absicht.", voice: Some("hero_isolde.m03_aufbruch_b"))]), AddObjective("obj_post1"), AddObjective("obj_post2"), AddObjective("obj_wendel"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn brach auf, die Graue Straße zu befreien.")], modes: []),
    (id: "post1", condition: TagDead("post1"), actions: [CompleteObjective("obj_post1"), Message(speaker: "Isolde Raventhorn", text: "Einer. Die Straße ist lang.", voice: None)], modes: []),
    (id: "post2", condition: TagDead("post2"), actions: [CompleteObjective("obj_post2"), Dialogue([(speaker: "Isolde Raventhorn", text: "Briefe. Das Wachs trägt das Siegel von Nordmark – und die Summe reicht, um eine Kompanie ein Jahr lang zu bezahlen.", voice: Some("hero_isolde.m03_briefe_a")), (speaker: "Isolde Raventhorn", text: "Jemand bezahlt die Räuber dafür, dass Brennhollow hungert. Das merke ich mir.", voice: Some("hero_isolde.m03_briefe_b"))])], modes: []),
    (id: "parley", condition: UnitsInArea(area: "wendel_zugang", count: 1), actions: [ChangeOwner(tag: "wendel", owner: 2), ChangeOwner(tag: "wendel_men", owner: 2), Dialogue([(speaker: "Ser Wendel der Graue", text: "Haltet ein, Wächterin! Ich lege die Klinge nieder – ich sehe, wann ein Spiel verloren ist. Und ich hasse es, für Verlierer zu arbeiten.", voice: Some("char_wendel.m03_wendel_a")), (speaker: "Isolde Raventhorn", text: "Du hast Fuhrleute erschlagen, Wendel. Ich habe die Karren gesehen.", voice: Some("hero_isolde.m03_wendel_b")), (speaker: "Ser Wendel der Graue", text: "Ich habe Befehle befolgt, die mit Gold kamen. Das ist kein Freispruch, ich weiß. Aber ich kenne jeden Pfad zwischen hier und Kaldris – und meine Männer können kämpfen.", voice: Some("char_wendel.m03_wendel_c"))]), Decision((id: "wendel", speaker: "Erzähler", title: "Ser Wendel der Graue", text: "Ein Wegelagerer, der um sein Leben handelt. Die Flamme verlangt Gerechtigkeit – aber Brennhollow braucht Schwerter. Die Entscheidung liegt bei der Wächterin.", voice: Some("narrator.m03_wendel_d"), options: [(flag: "wendel_hanged", label: "Ser Wendel hängen", detail: "Die Straße ist gerächt, doch Wendels Männer zerstreuen sich.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Du hängst, Wendel. Für jeden Karren, den du verbrannt hast. Die Straße braucht keine Reue, sie braucht Ruhe.", voice: Some("hero_isolde.m03_wendel_a_a")), (speaker: "Ser Wendel der Graue", text: "Gerecht. Fast. Sagt den Fuhrleuten … dass ich sie gezählt habe.", voice: Some("char_wendel.m03_wendel_a_b"))])]), (flag: "wendel_recruited", label: "Die Graue Kompanie in Dienst nehmen", detail: "Die Männer kämpfen später an Eurer Seite.", requires: [], actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Du dienst mir, bis die Straße sicher ist. Wenn du uns verrätst, hole ich dich persönlich.", voice: Some("hero_isolde.m03_wendel_b_a")), (speaker: "Ser Wendel der Graue", text: "Die Graue Kompanie steht Euch zu Diensten, Wächterin. Es ist das erste Mal seit Jahren, dass ich bei Tag schlafen kann.", voice: Some("char_wendel.m03_wendel_b_b"))])])]))], modes: []),
    (id: "recruit_note", condition: Flag("wendel_recruited"), actions: [ChangeOwner(tag: "wendel", owner: 0), ChangeOwner(tag: "wendel_men", owner: 0)], modes: []),
    (id: "sieg", condition: All([Any([Flag("wendel_hanged"), Flag("wendel_recruited")]), ObjectiveCompleted("obj_post1"), ObjectiveCompleted("obj_post2")]), actions: [CompleteObjective("obj_wendel"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Am Abend zogen die ersten Karren seit zwei Jahren nordwärts. Die Aschmark war immer noch ein Grenzland – aber nun eines mit einer Straße.", voice: Some("narrator.m03_sieg_a"))]), Chronicle("Die Graue Straße wurde befreit."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel auf der Grauen Straße.", voice: None), Defeat], modes: []),
  ],
  defeat_tag: "",
  enemy_base_tag: "",
