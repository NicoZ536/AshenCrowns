    (id: "ghoul", owner: 1, x: 34.0, y: 18.0, count: 4, tag: None, guard: true, camp: None),
    (id: "ghoul", owner: 1, x: 54.0, y: 18.0, count: 4, tag: None, guard: true, camp: None),
    (id: "ash_witch", owner: 1, x: 44.0, y: 14.0, count: 2, tag: None, guard: true, camp: None),
  ],
  objectives: [
    (id: "obj_halls", text: "Kämpft Euch durch den Vorraum und die Halle der Ahnen.", optional: false),
    (id: "obj_gharun", text: "Bezwingt Gharun, den Steinernen Eid.", optional: false),
    (id: "obj_shrine", text: "Weiht den Schrein Oruuns neu.", optional: false),
    (id: "obj_hero", text: "Isolde Raventhorn darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "stollen", condition: AtTime(1.0), actions: [Dialogue([(speaker: "Erzähler", text: "Der Berg hatte seit dem Aschenfall nicht mehr gesprochen. Wer an seiner Flanke stand, spürte ihn manchmal zittern – wie ein Schlafender, der etwas Schlimmes träumt.", voice: Some("narrator.m21_stollen_a")), (speaker: "Isolde Raventhorn", text: "Der Weg führt durch drei Hallen. Haltet die Reihen geschlossen, und wenn der Stein spricht: nicht antworten.", voice: Some("hero_isolde.m21_stollen_b"))]), AddObjective("obj_halls"), AddObjective("obj_gharun"), AddObjective("obj_shrine"), AddObjective("obj_hero"), Chronicle("Isolde Raventhorn drang in den Stollen unter den Gipfeln Skarnheims ein.")], modes: []),
    (id: "torvald", condition: All([Flag("torvald_blood"), AtTime(8.0)]), actions: [Dialogue([(speaker: "Torvald Eisenhand", text: "Meine Väter haben diesen Schrein mit eigenen Händen gebaut. Dass ich ihn nun mit der Axt zurückfordern muss, ist eine Schande, die ich gern wasche.", voice: Some("char_torvald.m21_torvald_a"))])], modes: []),
    (id: "soeldner", condition: All([Flag("torvald_gold"), AtTime(8.0)]), actions: [Dialogue([(speaker: "Isolde Raventhorn", text: "Gold kauft Schwerter, aber keine Trauer. Dieser Berg ist nicht meiner – und doch kämpfe ich um ihn.", voice: Some("hero_isolde.m21_soeldner_a"))])], modes: []),
    (id: "hallen", condition: UnitsInArea(area: "schreinsaal", count: 1), actions: [CompleteObjective("obj_halls"), Dialogue([(speaker: "Gharun, der Steinerne Eid", text: "Wer wagt es, den Eid zu stören? Ich wurde gebunden, zu bewahren – und ich bewahre. Was ich bewahre, spricht nicht mehr mit euch.", voice: Some("boss_stone_oath.m21_gharun_a")), (speaker: "Isolde Raventhorn", text: "Du bewahrst den Falschen, Wächter. Wir sind gekommen, den Schrein zurückzuholen – und deinen Eid zu lösen.", voice: Some("hero_isolde.m21_gharun_b"))]), SetWeather(Fog)], modes: []),
    (id: "beben", condition: TagHealthBelow(tag: "boss", percent: 50.0), actions: [Chronicle("Der Berg bebte unter dem Streit um Oruuns Schrein."), SpawnUnits(unit: "ghoul", owner: 1, area: "schreinsaal", count: 3, attack: true, tag: None)], modes: []),
    (id: "sieg", condition: TagDead("boss"), actions: [CompleteObjective("obj_gharun"), CompleteObjective("obj_shrine"), CompleteObjective("obj_hero"), Dialogue([(speaker: "Erzähler", text: "Gharun zerfiel zu Staub, der in der Luft stand, als wollte er sich noch einmal verbeugen. Der Eid war nicht gebrochen, sondern erfüllt: Der Schrein war in Sicherheit.", voice: Some("narrator.m21_sieg_a")), (speaker: "Isolde Raventhorn", text: "Oruun, wenn du zuhörst: Der Schrein ist dein. Wir kommen wieder, wenn du uns brauchst.", voice: Some("hero_isolde.m21_sieg_b"))]), Chronicle("Der Schrein Oruuns wurde neu geweiht."), Victory], modes: []),
    (id: "hero_lost", condition: TagDead("hero"), actions: [Message(speaker: "Erzähler", text: "Isolde Raventhorn fiel im Schreinsaal Oruuns.", voice: None), Defeat], modes: []),
  ],
