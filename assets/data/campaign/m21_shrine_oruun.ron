    (id: "hollow_archer", owner: 1, x: 44.0, y: 63.0, count: 4, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 32.0, y: 46.0, count: 6, tag: None, guard: true, camp: None),
    (id: "hollow_thrall", owner: 1, x: 56.0, y: 46.0, count: 6, tag: None, guard: true, camp: None),
