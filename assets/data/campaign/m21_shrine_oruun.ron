(
  id: "m21_shrine_oruun",
  name: "Der Schrein Oruuns",
  description: "Unter den Gipfeln Skarnheims liegt der Schrein des Steingotts Oruun – von Gharun, dem Steinernen Eid, in Besitz genommen. Kämpft Euch durch die Hallen und weiht den Schrein neu.",
  map_seed: 92021,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 0.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
