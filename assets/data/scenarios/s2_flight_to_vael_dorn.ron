    (id: "hollow_thrall", owner: 1, x: 31.5, y: 79.0, count: 4, tag: None, guard: true),
    (id: "hollow_archer", owner: 1, x: 29.0, y: 81.5, count: 2, tag: None, guard: true),
    (id: "hollow_thrall", owner: 1, x: 44.0, y: 57.0, count: 3, tag: None, guard: true),
