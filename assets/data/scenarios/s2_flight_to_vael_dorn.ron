(
  id: "sc_flight_to_vael_dorn",
  name: "Die Flucht nach Vael Dorn",
  description: "Das Dorf brennt, die Hohlen sind dicht hinter Euch. Führt die Flüchtlinge durch die Aschmark über zwei Furten zu den alten Klostermauern von Vael Dorn.",
  map_seed: 894,
  start_resources: (
    gold: 0.0,
    wood: 0.0,
    stone: 0.0,
    food: 300.0,
  ),
  start_goods: [],
  waves: (
    enabled: false,
    first_wave: 200.0,
    interval_day: 150.0,
    interval_night: 95.0,
    base_budget: 3.0,
    budget_per_wave: 1.7,
    night_mult: 1.5,
  ),
  placements: [
    (id: "worker", owner: 0, x: 10.0, y: 98.0, count: 16, tag: None, guard: false),
    (id: "swordsman", owner: 0, x: 15.5, y: 94.0, count: 4, tag: None, guard: false),
