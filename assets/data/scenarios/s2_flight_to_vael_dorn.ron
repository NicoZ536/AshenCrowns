    (id: "hollow_thrall", owner: 1, x: 58.5, y: 41.0, count: 5, tag: None, guard: true),
    (id: "hollow_archer", owner: 1, x: 56.0, y: 43.0, count: 2, tag: None, guard: true),
    (id: "grave_brute", owner: 1, x: 60.5, y: 38.5, count: 1, tag: None, guard: true),
    (id: "hollow_thrall", owner: 1, x: 78.5, y: 34.0, count: 4, tag: None, guard: true),
    (id: "hollow_archer", owner: 1, x: 80.0, y: 31.0, count: 2, tag: None, guard: true),
    (id: "grave_brute", owner: 1, x: 86.0, y: 28.0, count: 1, tag: None, guard: true),
    (id: "hollow_thrall", owner: 1, x: 93.0, y: 20.5, count: 5, tag: None, guard: true),
    (id: "hollow_archer", owner: 1, x: 95.5, y: 18.0, count: 3, tag: None, guard: true),
    (id: "hollow_thrall", owner: 1, x: 40.0, y: 20.0, count: 4, tag: None, guard: true),
  ],
  objectives: [
    (id: "obj_reach", text: "Führt mindestens zwölf Seelen nach Vael Dorn.", optional: false),
    (id: "obj_keep_refugees", text: "Verliert nicht mehr als acht Flüchtlinge.", optional: false),
    (id: "obj_ford1", text: "Überquert den Fluss an der unteren Furt.", optional: true),
    (id: "obj_ford2", text: "Überquert den zweiten Fluss an der oberen Furt.", optional: true),
  ],
  triggers: [
    (id: "intro", condition: AtTime(1.0), actions: [AddObjective("obj_reach"), AddObjective("obj_keep_refugees"), AddObjective("obj_ford1"), Message(speaker: "Vogt Aldous Meringer", text: "Weiter, weiter! Die Klostermauern von Vael Dorn halten, hat man mir gesagt. Nach Nordosten, der alten Straße nach – und nicht stehenbleiben!", voice: None), Chronicle("Vogt Meringer führte die Überlebenden der Dörfer in Richtung Vael Dorn.")], modes: []),
    (id: "pursuit1", condition: AtTime(40.0), actions: [Message(speaker: "Isolde Raventhorn", text: "Hinter uns! Sie holen auf – nicht umdrehen!", voice: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 8, attack: true)], modes: []),
    (id: "pursuit2", condition: AtTime(100.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 6, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "dorf", count: 2, attack: true)], modes: []),
    (id: "pursuit3", condition: AtTime(170.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "dorf", count: 8, attack: true), SpawnUnits(unit: "grave_brute", owner: 1, area: "dorf", count: 1, attack: true)], modes: []),
    (id: "ford1", condition: UnitsInArea(area: "furt1", count: 3), actions: [CompleteObjective("obj_ford1"), AddObjective("obj_ford2"), Message(speaker: "Vogt Aldous Meringer", text: "Das Wasser ist kalt, aber es hält sie nicht auf. Weiter!", voice: None)], modes: []),
    (id: "ambush1", condition: UnitsInArea(area: "falle1", count: 1), actions: [Message(speaker: "Isolde Raventhorn", text: "Hinterhalt im Unterholz! Schließt auf!", voice: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "falle1_spawn", count: 3, attack: true)], modes: []),
    (id: "ford2", condition: UnitsInArea(area: "furt2", count: 3), actions: [CompleteObjective("obj_ford2"), Message(speaker: "Erzähler", text: "Hinter dem zweiten Fluss lag die Aschmark still. Zu still.", voice: None)], modes: []),
    (id: "ambush2", condition: UnitsInArea(area: "falle2", count: 1), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "falle2_spawn", count: 3, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "falle2_spawn", count: 1, attack: true)], modes: []),
    (id: "lost", condition: Not(UnitCount(unit: "worker", count: 8)), actions: [Message(speaker: "Erzähler", text: "Zu wenige erreichten das Kloster. Die Stille der Aschmark schloss sich über ihnen.", voice: None), Defeat], modes: []),
    (id: "arrived", condition: UnitsInArea(area: "vael_dorn", count: 12), actions: [CompleteObjective("obj_reach"), CompleteObjective("obj_keep_refugees"), Message(speaker: "Vogt Aldous Meringer", text: "Die Mauern halten! Schließt das Tor, bringt die Verwundeten ins Innere. Hier sind wir sicher.", voice: None), Message(speaker: "Erzähler", text: "Er irrte sich. Aber das wusste an diesem Abend noch niemand.", voice: None), Chronicle("Die Flüchtlinge erreichten die Ruinen von Vael Dorn. Im Frühjahr kehrte keiner von ihnen zurück."), Victory], modes: []),
  ],
