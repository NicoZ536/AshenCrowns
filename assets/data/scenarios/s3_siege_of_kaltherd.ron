  objectives: [
    (id: "obj_wall", text: "Errichtet eine Mauer mit Tor um Kaltherd.", optional: true),
    (id: "obj_night1", text: "Übersteht die erste Nacht.", optional: false),
    (id: "obj_night2", text: "Übersteht die zweite Nacht.", optional: false),
    (id: "obj_hall", text: "Der Bergfried darf nicht fallen.", optional: false),
  ],
  triggers: [
    (id: "intro", condition: AtTime(1.0), actions: [AddObjective("obj_night1"), AddObjective("obj_hall"), AddObjective("obj_wall"), Message(speaker: "Isolde Raventhorn", text: "Wir haben bis zum Abend Zeit. Stein und Holz liegen im Lager – zieht die Mauer, setzt ein Tor nach Süden, und stellt Türme an die Ecken.", voice: None)], modes: []),
    (id: "wall_done", condition: BuildingCompleted("gate"), actions: [CompleteObjective("obj_wall")], modes: []),
    (id: "n1a", condition: AtTime(190.0), actions: [Message(speaker: "Erzähler", text: "Der erste Nebel stieg aus der Asche. Man hörte sie, bevor man sie sah.", voice: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "ost", count: 8, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "ost", count: 2, attack: true)], modes: []),
    (id: "n1b", condition: AtTime(240.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 8, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "west", count: 3, attack: true)], modes: []),
    (id: "n1c", condition: AtTime(290.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "nord", count: 8, attack: true), SpawnUnits(unit: "grave_brute", owner: 1, area: "nord", count: 1, attack: true)], modes: []),
    (id: "n1_done", condition: DayStarted(2), actions: [CompleteObjective("obj_night1"), AddObjective("obj_night2"), Grant((gold: 120.0, wood: 120.0, stone: 160.0, food: 0.0)), Message(speaker: "Isolde Raventhorn", text: "Eine Nacht überstanden. Flickt die Mauer. Die nächste wird schlimmer.", voice: None)], modes: []),
    (id: "n2a", condition: AtTime(550.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "ost", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "ost", count: 3, attack: true), SpawnUnits(unit: "grave_brute", owner: 1, area: "ost", count: 1, attack: true)], modes: []),
    (id: "n2b", condition: AtTime(600.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "sued", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "sued", count: 4, attack: true)], modes: []),
    (id: "n2c", condition: AtTime(650.0), actions: [Message(speaker: "Erzähler", text: "Mit den Toten kam etwas Größeres: Gestalten, die Mauern nicht fürchteten.", voice: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "west", count: 2, attack: true), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "west", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "nord", count: 4, attack: true)], modes: []),
    (id: "victory", condition: DayStarted(3), actions: [CompleteObjective("obj_night2"), CompleteObjective("obj_hall"), Message(speaker: "Erzähler", text: "Am dritten Morgen standen die Mauern von Kaltherd noch. Die Hohlen aber hatten sich in die Asche zurückgezogen – für diesmal.", voice: None), Chronicle("Kaltherd überstand zwei Nächte der Belagerung."), Victory], modes: []),
  ],
