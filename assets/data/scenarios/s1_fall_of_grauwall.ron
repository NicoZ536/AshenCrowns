  objectives: [
    (id: "obj_hold", text: "Haltet Grauwall bis zum Morgengrauen.", optional: false),
    (id: "obj_keep", text: "Der Bergfried darf nicht fallen.", optional: false),
    (id: "obj_brutes", text: "Zerschlagt die Grabkolosse, bevor sie die Mauer einreißen.", optional: true),
  ],
  triggers: [
    (id: "intro", condition: AtTime(1.0), actions: [AddObjective("obj_hold"), AddObjective("obj_keep"), Message(speaker: "Markgraf Edran Raventhorn", text: "Die Tore sind verriegelt, Isolde. Haltet die Mauer, bis die Letzten den Hügel erreicht haben – dann folgt Ihr ihnen. Das ist ein Befehl Eures Vaters, nicht des Markgrafen.", voice: None), Chronicle("In der Nacht des Falls hielt die Garnison von Grauwall die Mauerkrone.")], modes: []),
    (id: "fog", condition: AtTime(20.0), actions: [SetWeather(Ashfall)], modes: []),
    (id: "w1", condition: AtTime(30.0), actions: [Message(speaker: "Isolde Raventhorn", text: "Sie kommen von Westen! Bogenschützen auf die Mauer!", voice: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_west", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_west", count: 2, attack: true)], modes: []),
    (id: "w2", condition: AtTime(75.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_nord", count: 12, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_nord", count: 4, attack: true)], modes: []),
    (id: "w3", condition: AtTime(115.0), actions: [Message(speaker: "Erzähler", text: "Aus dem Süden drang das Knirschen schwerer Schritte. Etwas Großes trug die Toten wie ein Hirte seine Herde.", voice: None), SpawnUnits(unit: "grave_brute", owner: 1, area: "flut_sued", count: 2, attack: true), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_sued", count: 10, attack: true)], modes: []),
    (id: "w4", condition: AtTime(150.0), actions: [SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_west", count: 14, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_west", count: 6, attack: true), SpawnUnits(unit: "grave_brute", owner: 1, area: "flut_nord", count: 2, attack: true)], modes: []),
    (id: "w5", condition: AtTime(185.0), actions: [Message(speaker: "Markgraf Edran Raventhorn", text: "Zum letzten Mal, Isolde: Haltet den Bergfried!", voice: None), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_sued", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_nord", count: 4, attack: true), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_west", count: 10, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_west", count: 2, attack: true)], modes: []),
    (id: "w6", condition: AtTime(170.0), actions: [SpawnUnits(unit: "grave_brute", owner: 1, area: "flut_sued", count: 2, attack: true), SpawnUnits(unit: "hollow_thrall", owner: 1, area: "flut_nord", count: 12, attack: true), SpawnUnits(unit: "hollow_archer", owner: 1, area: "flut_sued", count: 5, attack: true)], modes: []),
    (id: "dawn", condition: DayStarted(2), actions: [CompleteObjective("obj_hold"), CompleteObjective("obj_keep"), Message(speaker: "Erzähler", text: "Als das Licht kam, standen noch Männer auf der Mauer. Der Zug der Flüchtlinge war über den Hügel. Grauwall aber war verloren – und mit ihm Edran Raventhorn, der nicht mehr vom Wall herabstieg.", voice: None), Chronicle("Grauwall fiel in einer einzigen Nacht; seine Garnison verschaffte den Flüchtlingen den Vorsprung."), Victory], modes: []),
  ],
  defeat_tag: "player_keep",
