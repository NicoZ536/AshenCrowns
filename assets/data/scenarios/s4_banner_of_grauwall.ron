  areas: [
    (id: "lager", name: "Lager der Kolonne", x: 6, y: 54, w: 20, h: 20),
    (id: "grauwall", name: "Die Ruinen von Grauwall", x: 50, y: 10, w: 24, h: 24),
  ],
  starts: [
    (owner: 0, x: 17.0, y: 62.0),
    (owner: 1, x: 62.0, y: 18.0),
  ],
  briefing: "Grauwall, Jahr 898 n.F. Der Fahle Vogt ist gefallen, Brennhollow atmet auf. Doch Grauwall, die Stammfeste von Haus Raventhorn, ist eine stille, hohle Ruine, deren Banner noch an den Mauern hängt. Späher berichten von einem neuen Hohlschrein im Hof und von einer Gestalt in Markgrafenrüstung, die der Schrein lenkt. Isolde führt eine Kolonne aus Brennhollow: ein Lager im Südwesten, eine Kaserne, eine Hand voll Soldaten. Baut Euer Lager aus, bildet Truppen aus, zerstört den Schrein und bringt den Grabkoloss in Edrans Rüstung zur Ruhe. Die Hohlen schicken Wellen, solange der Schrein steht.",
  author: "Ashen Crowns",
  year: Some(898),
  unit_cap: None,
  start_time: None,
)