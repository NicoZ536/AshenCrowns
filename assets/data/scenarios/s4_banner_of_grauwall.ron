    (id: "obj_shrine", text: "Zerstört den Hohlschrein von Grauwall.", optional: false),
    (id: "obj_edran", text: "Bringt den Grabkoloss in Edrans Rüstung zur Ruhe.", optional: false),
    (id: "obj_army", text: "Bildet eine Streitmacht von mindestens zwölf Soldaten aus.", optional: true),
