// ASHEN CROWNS – Globale Regelwerte
(
    tick_rate: 20,
    day_length: 360.0,
    tree_wood: 120,
    gold_mine_gold: 6000,
    quarry_stone: 2000,
    gather_time: 3.5,
    max_population: 80,
    hero_respawn_time: 40.0,
    xp_levels: [0, 100, 250, 450, 700, 1000, 1400, 1900, 2500, 3200],
    night_sight_mult: 0.7,
    fog_sight_mult: 0.75,
    rain_ranged_mult: 0.9,
    demolish_refund: 0.5,

    // Helden: Wiederbelebung (Gold = Grundkosten + Zuschlag je Stufe), Aufnahmeradius der Beute.
    hero_revive_base: 150.0,
    hero_revive_per_level: 60.0,
    hero_altar_hp: 0.8,
    hero_keep_hp: 0.5,
    pickup_radius: 1.3,
    // Beute eines vollständig vernichteten Lagers (Gegenstand, Gewicht); je Lager zwei Würfe.
    camp_loot: [
        ("potion_heal", 6.0), ("potion_mana", 4.0), ("potion_heal_greater", 4.0), ("potion_ember", 2.0), ("potion_ward", 2.0),
        ("steel_sword", 3.0), ("chain_hauberk", 3.0), ("embersteel_blade", 3.0), ("skarn_greataxe", 2.0), ("ember_plate", 2.0),
        ("pilgrim_staff", 2.0), ("oath_medal", 2.0), ("ember_ring", 3.0), ("wolf_signet", 2.0), ("flamekeeper_pendant", 2.0),
        ("edran_blade", 1.0), ("grauwall_aegis", 1.0), ("ashglass_heart", 1.0), ("varkhan_signet", 1.0),
    ],

    // Gegner-KI des Gefechts je Schwierigkeitsgrad: Leicht, Normal, Schwer, Albtraum (siehe docs/design/rts_military.md).
    ai_levels: [
        (name: "Leicht", think: 3.0, workers: 5, income_mult: 0.8, army_mult: 0.7, first_attack: 600.0, attack_interval: 240.0,
         tech_interval: 900.0, counter_skill: 0.15, retreat_ratio: 0.3, max_army: 16, harass: false, towers: 0),
        (name: "Normal", think: 2.0, workers: 8, income_mult: 1.0, army_mult: 1.0, first_attack: 420.0, attack_interval: 160.0,
         tech_interval: 420.0, counter_skill: 0.6, retreat_ratio: 0.5, max_army: 28, harass: false, towers: 1),
        (name: "Schwer", think: 1.5, workers: 10, income_mult: 1.25, army_mult: 1.3, first_attack: 330.0, attack_interval: 120.0,
         tech_interval: 300.0, counter_skill: 0.85, retreat_ratio: 0.65, max_army: 44, harass: false, towers: 3),
        (name: "Albtraum", think: 1.0, workers: 12, income_mult: 1.6, army_mult: 1.6, first_attack: 260.0, attack_interval: 90.0,
         tech_interval: 210.0, counter_skill: 1.0, retreat_ratio: 0.75, max_army: 60, harass: true, towers: 4),
    ],

    // Stadtsimulation: Lager, Arbeitskräfte, Bevölkerung, Steuern, Markt.
    city: (
        logistics_radius: 14.0,   // Produktion braucht ein Lager (Bergfried/Lagerhaus) in dieser Reichweite
        workforce_ratio: 0.8,     // Anteil der Bewohner, der arbeiten kann
        happiness_rate: 3.0,      // Punkte pro Sekunde in Richtung Zielwert
        growth_min_happiness: 35.0,
        growth_rate: 0.08,        // Zuzug je Haus und Sekunde
        emigration_rate: 0.12,    // Abwanderung je Haus und Sekunde bei Unruhe
        unrest_below: 20.0,
        upgrade_above: 70.0,
        upgrade_time: 25.0,
        downgrade_time: 40.0,
        default_tax: 2,
        tax_levels: [
            (name: "Keine", income: 0.0, happiness: 15.0),
            (name: "Niedrig", income: 0.5, happiness: 6.0),
            (name: "Normal", income: 1.0, happiness: 0.0),
            (name: "Hoch", income: 1.6, happiness: -14.0),
            (name: "Drückend", income: 2.4, happiness: -32.0),
        ],
        price_wood: 2.0,
        price_stone: 3.0,
        price_food: 1.5,
        market_fee: 0.12,
        market_impact: 0.02,
        market_recovery: 0.012,
        market_min: 0.4,
        market_max: 2.6,
    ),

    // Ausbaustufen der Siedlung. Stufe 0 (Siedlung) ist der Anfangszustand; jeder Eintrag
    // beschreibt den Ausbau *zur* nächsten Stufe. Gebäude nennen ihre Mindeststufe in `era`.
    eras: [
        (
            id: "castle", name: "Burg",
            description: "Der Bergfried wird zur Burg ausgebaut: Eisenverarbeitung, Mauertürme und Bürgerhäuser werden möglich, die Lager wachsen.",
            cost: (gold: 450.0, wood: 200.0, stone: 300.0),
            goods: [("planks", 40.0), ("bricks", 40.0)],
            requires: [("house", 2), ("storehouse", 1)],
            build_time: 60.0, storage_bonus: 200.0, pop_bonus: 10,
        ),
    ],
)
